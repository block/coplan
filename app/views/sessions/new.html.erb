<% content_for(:title) { t("coplan.sign_in.messages.sign_in_coplan") } %>

<div class="sign-in-page">
  <div class="sign-in-card card">
    <h1>Coplan</h1>
    <p class="text-muted text-sm"><%= t("coplan.sign_in.sign_in_with_your_work") %></p>

    <div class="sign-in-warning">
      <%= t("coplan.sign_in.this_example_host_uses_email") %>
    </div>

    <% if @demo_user %>
      <p class="text-muted text-sm"><%= t("coplan.interface.demo_sign_in_html", email: tag.strong(@demo_user.email)) %></p>
    <% end %>

    <%= form_with url: sign_in_path, method: :post, class: "sign-in-form" do |f| %>
      <div class="form-group">
        <%= f.label :email, t("coplan.sign_in.messages.email_address") %>
        <%= f.email_field :email, value: @demo_user&.email, autofocus: true, required: true, placeholder: "you@company.com" %>
      </div>

      <%= f.submit t("coplan.sign_in.messages.sign_in"), class: "btn btn--primary sign-in-submit" %>
    <% end %>

    <% if @demo_users.present? %>
      <section class="demo-accounts" aria-labelledby="demo-accounts-heading">
        <h2 id="demo-accounts-heading" class="text-sm"><%= t("coplan.sign_in.demo_accounts") %></h2>
        <p class="text-muted text-sm"><%= t("coplan.sign_in.choose_an_account_to_sign") %></p>
        <ul class="demo-account-list">
          <% @demo_users.each do |user| %>
            <li>
              <%= button_to sign_in_path, method: :post, params: { email: user.email }, class: "btn btn--secondary demo-account-button", data: { turbo_submits_with: t("coplan.sign_in.messages.signing_in_pending") } do %>
                <span><%= user.email %></span>
                <span class="text-muted text-sm"><%= user == @demo_user ? t("coplan.sign_in.messages.default_owner") : user.title %><%= t("coplan.sign_in.messages.admin") if user.admin? %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
