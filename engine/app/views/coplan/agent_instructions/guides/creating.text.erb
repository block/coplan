|------|-------------|----------|
<% @plan_types.each do |pt| %>
| `<%= pt.name %>` | <%= pt.description.present? ? pt.description : "—" %> | <%= pt.template_content.present? ? "yes — fetch and follow it" : "—" %> |
<% end %>
