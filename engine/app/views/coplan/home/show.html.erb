<% content_for(:title, @tag ? "##{@tag} — Feed — Coplan" : t("coplan.feed.messages.feed_coplan")) %>

<div class="home">
  <header class="home__header">
    <h1 class="home__title"><%= t("coplan.common.feed") %></h1>
    <%# A tag chip narrows the feed rather than opening a list of its own —
        same clearable-state treatment the workspace filters get. %>
    <% if @tag %>
      <div class="active-filter workspace__filters">
        <span class="workspace__filter-chip">
          #<%= @tag %>
          <%= link_to "✕", home_path, class: "workspace__filter-clear",
                aria: { label: t("coplan.feed.messages.clear_tag_filter", tag: @tag) } %>
        </span>
      </div>
    <% end %>
  </header>

  <% if @items.empty? %>
    <div class="home__empty">
      <% if @tag %>
        <p><%= t("coplan.interface.empty_tagged_feed", tag: @tag) %></p>
        <p class="text-muted text-sm"><%= link_to t("coplan.feed.messages.see_everything"), home_path, class: "landing__inline-link" %></p>
      <% else %>
        <p><%= t("coplan.feed.no_published_activity_in_the") %></p>
        <p class="text-muted text-sm"><%= t("coplan.feed.when_someone_publishes_edits_or") %></p>
      <% end %>
    </div>
  <% else %>
    <% @items_by_date.each do |date, items| %>
      <section class="home__day">
        <h2 class="home__day-heading">
          <% if date == Date.current %><%= t("coplan.feed.today") %>
          <% elsif date == Date.current - 1 %><%= t("coplan.feed.yesterday") %>
          <% else %><%= l(date, format: t("coplan.display.date_feed")) %><% end %>
        </h2>
        <ul class="home__feed">
          <% items.each do |item| %>
            <% plan = item.plan %>
            <li class="home__item">
              <span class="home__item-avatar">
                <%= link_to user_avatar(plan.created_by_user, size: "md"), profile_path_for(plan.created_by_user), title: plan.created_by_user.name %>
              </span>
              <div class="home__item-body">
                <div class="home__item-line">
                  <%= plan_type_icon(plan, size: :sm) %>
                  <%= link_to plan.title, plan_browse_path(plan), class: "home__item-title" %>
                  <% summary_parts = item.summary_parts %>
                  <% if summary_parts.any? %>
                    <span class="home__item-activity">
                      <% if item.published %>
                        <span class="home__item-activity--new"><%= t("coplan.feed.new") %></span><%= " · #{summary_parts.drop(1).join(" · ")}" if summary_parts.size > 1 %>
                      <% else %>
                        <%= summary_parts.join(" · ") %>
                      <% end %>
                    </span>
                  <% end %>
                </div>
                <div class="home__item-meta text-muted">
                  <%= t("coplan.interface.by_author_html", author: profile_link(plan.created_by_user)) %>
                  <% plan.tags.first(3).each do |tag| %>
                    <%= link_to "##{tag.name}", home_path(tag: tag.name), class: "home__item-tag" %>
                  <% end %>
                </div>
              </div>
              <span class="home__item-time text-muted" title="<%= item.last_activity_at %>">
                <%= relative_ui_time(item.last_activity_at) %>
              </span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
</div>
