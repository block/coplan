<%# Per-viewer affordances (Edit/Delete) are hidden client-side by the
    comment_actions Stimulus controller — one broadcast is shared with every
    `current_user`, so we ship the button on every human comment and let
    the browser remove it for non-authors. Server still enforces auth. %>
<div class="comment <%= 'comment--deleted' if comment.deleted? %> <%= 'comment--agent' if comment.agent? %>"
     id="<%= dom_id(comment) %>"
     data-controller="coplan--comment-actions"
     data-comment-id="<%= comment.id %>"
     data-comment-version="<%= comment.cache_key_with_version %>"
     data-coplan--comment-actions-author-id-value="<%= comment.author_id %>"
     data-coplan--comment-actions-author-type-value="<%= comment.author_type %>">
  <% if comment.deleted? %>
    <div class="comment__body text-sm text-muted">
      <em>Comment deleted</em>
    </div>
  <% else %>
    <div class="comment__header text-sm text-muted">
      <% author = comment_author_user(comment) %>
      <% if comment.agent? %>
        <%= image_tag comment_agent_icon_source(comment), alt: "", class: "comment__agent-avatar" %>
        <strong class="comment__agent-name"><%= comment.agent_harness&.display_name.presence || comment.agent_name.presence || "Agent" %></strong>
        <span class="comment__agent-owner"><%= comment_agent_owner_label(comment) %></span>
      <% elsif author %>
        <%= user_avatar(author) %>
        <strong><%= profile_link(author) %></strong>
      <% else %>
        <strong><%= comment_author_name(comment) %></strong>
      <% end %>
      <span class="comment__meta"><%= time_ago_in_words(comment.created_at) %> ago<% if comment.updated_at > comment.created_at %><span class="comment__edited"> · edited</span><% end %></span>
    </div>
    <div class="comment__body" data-coplan--comment-actions-target="body">
      <%# The record version invalidates edits; bump this namespace when Markdown rendering changes. %>
      <%= cache(["comment-body-v2", comment], skip_digest: true) do %>
        <%# footnote_prefix keeps footnote ids unique per comment — the plan
            body and every other comment render in the same DOM. Comment
            images don't expand: the comments panel and footnote previews
            clone comment bodies, and a cloned expander can't work there. %>
        <%= render_markdown(comment.body_markdown, footnote_prefix: "comment-#{comment.id}", expandable_images: false) %>
      <% end %>
    </div>
    <% if comment.author_type == "human" %>
      <div class="comment__editor" data-coplan--comment-actions-target="editor" hidden>
        <%= form_with url: plan_comment_thread_comment_path(comment.comment_thread.plan, comment.comment_thread, comment), method: :patch, data: { action: "submit->coplan--comment-actions#save" } do %>
          <%= render "coplan/comment_threads/composer_fields", plan: comment.comment_thread.plan,
                label: "Edit comment", submit_label: "Save changes", field_name: "comment[body_markdown]",
                field_id: dom_id(comment, :edit_body), error_id: dom_id(comment, :edit_error), body: comment.body_markdown,
                cancel_action: "coplan--comment-actions#cancelEdit" %>
        <% end %>
      </div>
      <div class="comment__actions" data-coplan--comment-actions-target="delete" hidden>
        <button type="button" class="comment-window__action" data-action="coplan--comment-actions#edit">Edit</button>
        <%= button_to "Delete",
              plan_comment_thread_comment_path(comment.comment_thread.plan, comment.comment_thread, comment),
              method: :delete,
              form: { data: { turbo_confirm: "Delete this comment?" } },
              class: "comment-window__action" %>
      </div>
    <% end %>
  <% end %>
</div>
