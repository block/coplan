<div class="card">
  <h1><%= t("coplan.shared.changes_weren_t_saved") %></h1>
  <p role="alert"><%= t("coplan.interface.edit_locked_retry", message: message) %></p>
  <% if params.dig(:plan, :title).present? %><p><%= t("coplan.shared.title") %> <%= params.dig(:plan, :title) %></p><% end %>
  <% if params.dig(:plan, :tag_names).present? %><p><%= t("coplan.shared.tags") %> <%= params.dig(:plan, :tag_names) %></p><% end %>
  <% if params[:content].present? %>
    <label for="retained-draft"><%= t("coplan.shared.your_unsaved_draft") %></label>
    <textarea id="retained-draft" readonly rows="12"><%= params[:content] %></textarea>
  <% end %>
  <%= link_to t("coplan.shared.messages.return_to_document"), @plan ? plan_browse_path(@plan) : own_library_browse_path(current_user), class: "btn btn--secondary" %>
</div>
