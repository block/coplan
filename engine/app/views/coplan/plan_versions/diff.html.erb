<turbo-frame id="version-diff" data-coplan--history-target="frame">
  <div class="version-diff-preview">
    <div class="version-diff-preview__header">
      <h3><%= @previous_version ? "v#{@previous_version.revision}" : "Empty document" %> → v<%= @version.revision %></h3>
      <span class="text-sm text-muted">
        <% if @version.actor_user %>
          <%= user_avatar(@version.actor_user) %> <%= @version.actor_user.name %> ·
        <% else %>
          <%= @version.actor_type %> ·
        <% end %>
        <%= time_ago_in_words(@version.created_at) %> ago
        <% if @version.change_summary.present? %>
          · <%= @version.change_summary %>
        <% end %>
      </span>
      <%= link_to "View full version →", plan_version_browse_path(@plan, @version, from: @first_version.revision), class: "text-sm", data: { turbo_frame: "_top" } %>
    </div>

    <p class="text-sm text-muted">Combined changes introduced in <%= @first_version == @version ? "v#{@version.revision}" : "v#{@first_version.revision}–v#{@version.revision}" %>. Markdown source only.</p>
    <% if @diff.to_s.present? %>
      <div class="diff-view">
        <%= @diff.to_s(:html).html_safe %>
      </div>
    <% else %>
      <div class="text-sm text-muted" style="padding: var(--space-lg) 0;">
        No document text changed across these revisions.
      </div>
    <% end %>
  </div>
</turbo-frame>
