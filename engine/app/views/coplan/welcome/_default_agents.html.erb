<section class="landing__agents">
  <h2 class="landing__section-title"><%= t("coplan.welcome.built_for_any_ai_agent") %></h2>
  <p>
    <%= t("coplan.interface.setup_api_html", setup: link_to("/_/agent/setup", agent_setup_path, class: "landing__inline-link")) %>
    <% if Coplan.configuration.api_authenticate.present? %>
      <%= t("coplan.welcome.agents_can_mint_their_own") %>
    <% else %>
      <%= t("coplan.interface.agent_token_html", settings: tag.strong(t("coplan.welcome.settings_api_tokens"))) %>
    <% end %>
  </p>
  <%= render "coplan/shared/copy_url", url: agent_setup_url(format: :md) %>
</section>
