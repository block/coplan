<div class="landing">
  <header class="landing__hero">
    <p class="landing__kicker"><%= t("coplan.welcome.humans_comment_ai_agents_edit") %></p>
    <h1 class="landing__title"><%= t("coplan.welcome.design_docs_built_for_ai") %></h1>
    <p class="landing__lede">
      <%= t("coplan.welcome.coplan_gives_your_plans_a") %>
    </p>

    <div class="landing__cta-row">
      <% if signed_in? %>
        <%= link_to t("coplan.welcome.messages.go_to_your_library"), own_library_browse_path(current_user), class: "btn btn--primary" %>
      <% elsif Coplan.configuration.sign_in_path %>
        <%= link_to t("coplan.welcome.messages.sign_in_to_get_started"), Coplan.configuration.sign_in_path, class: "btn btn--primary" %>
      <% end %>
      <%= link_to t("coplan.welcome.messages.connect_your_agent"), agent_setup_path, class: "btn btn--secondary" %>
    </div>
  </header>

  <%# Illustrative mock of the review loop: a reviewer anchors a comment to a
      sentence, and an agent applies the edit — producing a new version. Pure
      HTML/CSS, no screenshots, so it inherits light/dark theming for free. %>
  <div class="landing-mock" aria-hidden="true">
    <div class="landing-mock__doc">
      <div class="landing-mock__doc-header">
        <span class="landing-mock__doc-title"><%= t("coplan.welcome.payment_retry_pipeline") %></span>
        <span class="landing-mock__badge landing-mock__badge--type"><%= t("coplan.welcome.design_doc") %></span>
        <span class="landing-mock__badge landing-mock__badge--version">v4</span>
      </div>
      <div class="landing-mock__doc-body">
        <p class="landing-mock__heading"><%= t("coplan.welcome.failure_handling") %></p>
        <p class="landing-mock__line">
          Failed charges are retried immediately, up to
          <mark class="landing-mock__highlight">ten times in a tight loop</mark>,
          before the invoice is marked delinquent.
        </p>
        <p class="landing-mock__line landing-mock__line--dim">
          <%= t("coplan.welcome.webhooks_notify_the_billing_service") %>
        </p>
      </div>
    </div>

    <div class="landing-mock__thread">
      <div class="landing-mock__comment">
        <div class="landing-mock__author"><%= t("coplan.welcome.priya_reviewer") %></div>
        <p><%= t("coplan.welcome.tight_loop_retries_will_hammer") %></p>
      </div>
      <div class="landing-mock__comment landing-mock__comment--agent">
        <div class="landing-mock__author">Claude <span class="landing-mock__agent-chip"><%= t("coplan.common.agent") %></span></div>
        <p><%= t("coplan.welcome.done_capped_at_5_attempts") %></p>
        <div class="landing-mock__provenance"><%= t("coplan.welcome.applied_edit_version_4") %></div>
      </div>
    </div>
  </div>

  <section class="landing__how">
    <h2 class="landing__section-title"><%= t("coplan.welcome.how_it_works") %></h2>

    <div class="landing__steps">
      <div class="landing__step">
        <div class="landing__step-number">1</div>
        <h3><%= t("coplan.welcome.write_a_plan") %></h3>
        <p>
          <%= t("coplan.welcome.a_plan_is_a_markdown") %>
        </p>
      </div>

      <div class="landing__step">
        <div class="landing__step-number">2</div>
        <h3><%= t("coplan.welcome.get_inline_feedback") %></h3>
        <p>
          <%= t("coplan.interface.feedback_and_mentions_html", username: tag.code("@username")) %>
        </p>
      </div>

      <div class="landing__step">
        <div class="landing__step-number">3</div>
        <h3><%= t("coplan.welcome.agents_apply_the_edits") %></h3>
        <p>
          <%= t("coplan.welcome.you_triage_the_feedback_agents") %>
        </p>
      </div>
    </div>
  </section>

  <section class="landing__features">
    <h2 class="landing__section-title"><%= t("coplan.welcome.what_you_get") %></h2>

    <div class="landing__feature-grid">
      <div class="landing__feature">
        <h3><%= t("coplan.welcome.inline_anchored_comments") %></h3>
        <p>
          <%= t("coplan.welcome.select_text_in_the_rendered") %>
        </p>
      </div>

      <div class="landing__feature">
        <h3><%= t("coplan.welcome.immutable_versions_with_provenance") %></h3>
        <p>
          <%= t("coplan.welcome.every_edit_produces_a_new") %>
        </p>
      </div>

      <div class="landing__feature">
        <h3><%= t("coplan.welcome.realtime_collaboration") %></h3>
        <p>
          <%= t("coplan.welcome.comments_edits_status_changes_and") %>
        </p>
      </div>

      <div class="landing__feature">
        <h3><%= t("coplan.welcome.a_semantic_agent_api") %></h3>
        <p>
          <%= t("coplan.interface.semantic_api_html", replace: tag.code("replace_exact"), insert: tag.code("insert_under_heading")) %>
        </p>
      </div>

      <div class="landing__feature">
        <h3><%= t("coplan.welcome.humans_comment_agents_edit") %></h3>
        <p>
          <%= t("coplan.welcome.the_editing_model_is_intentionally") %>
        </p>
      </div>

      <div class="landing__feature">
        <h3><%= t("coplan.welcome.works_with_any_agent") %></h3>
        <p>
          <%= t("coplan.interface.agent_instructions_html", setup: tag.code("/_/agent/setup"), reference: tag.code("/agent-instructions")) %>
        </p>
      </div>
    </div>
  </section>

  <%# The agents section is the one piece of the landing page hosts most often
      need to customize — generic Coplan points at /agent-instructions, while
      a deployment like coplan-square wants to tell its users to run
      `sq agents skills add coplan` instead. Renders via configuration so a
      host can swap this single section without forking the whole landing
      page. See `Coplan.configuration.landing_agents_partial`. %>
  <%= render Coplan.configuration.landing_agents_partial %>

  <footer class="landing__footer">
    <% if signed_in? %>
      <p>
        <%= t("coplan.common.signed_in_as") %> <strong><%= current_user.name %></strong>.
        <%= link_to t("coplan.welcome.messages.see_what_s_happening"), home_path, class: "landing__inline-link" %>
      </p>
    <% end %>
    <p class="landing__footer-oss">
      <%= t("coplan.interface.open_source_license_html", source: link_to(t("coplan.welcome.messages.open_source"), "https://github.com/block/coplan", class: "landing__inline-link")) %>
    </p>
  </footer>
</div>
