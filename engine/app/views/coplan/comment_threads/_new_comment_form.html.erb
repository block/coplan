<div class="comment-form comment-window" data-controller="coplan--composer" data-action="pointerdown@document->coplan--text-selection#dismissCommentOutside:capture input->coplan--composer#fitDraft focusin->coplan--composer#fitDraft resize@window->coplan--composer#constrain toggle->coplan--composer#toggled coplan:composer-close->coplan--composer#closed" id="new-comment-form" data-coplan--text-selection-target="form" style="display: none;">
  <%= render "coplan/comment_threads/window_controls", title: "New comment" %>
  <%= form_with url: plan_comment_threads_path(plan), method: :post, data: { controller: "coplan--comment-submit", action: "turbo:submit-start->coplan--comment-submit#started turbo:before-fetch-response->coplan--comment-submit#response turbo:fetch-request-error->coplan--comment-submit#failed turbo:submit-end->coplan--comment-submit#finished turbo:submit-end->coplan--text-selection#resetCommentForm" } do |f| %>
    <input type="hidden" name="comment_thread[anchor_text]" data-coplan--text-selection-target="anchorInput" value="">
    <input type="hidden" name="comment_thread[anchor_context]" data-coplan--text-selection-target="contextInput" value="">
    <input type="hidden" name="comment_thread[anchor_occurrence]" data-coplan--text-selection-target="occurrenceInput" value="">
    <div class="comment-form__anchor" data-coplan--text-selection-target="anchorPreview" style="display: none;">
      <span class="text-sm text-muted">Commenting on:</span>
      <blockquote class="comment-form__quote" data-coplan--text-selection-target="anchorQuote"></blockquote>
    </div>
    <%= render "coplan/comment_threads/composer_fields", plan: plan %>
  <% end %>
</div>
