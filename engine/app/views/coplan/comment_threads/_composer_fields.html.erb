<% label = local_assigns.fetch(:label, t("coplan.discussions.messages.new_comment")) %>
<% submit_label = local_assigns.fetch(:submit_label, t("coplan.common.comment")) %>
<div class="composer" data-controller="coplan--comment-form"
     data-action="coplan:composer-close@document->coplan--comment-form#composerClosed resize@window->coplan--comment-form#positionLink scroll@document->coplan--comment-form#positionLink:capture"
     data-coplan--comment-form-link-search-url-value="<%= coplan.search_path %>"
     data-coplan--comment-form-search-url-value="<%= search_users_path %>">
  <div class="composer__draft" data-coplan--comment-form-target="draft">
    <div class="composer__writing" data-controller="coplan--dictation"
         data-coplan--dictation-url-value="<%= plan_dictations_path(local_assigns.fetch(:plan)) %>"
         data-coplan--dictation-transcription-value="<%= Coplan::Ai.available? %>"
         data-action="coplan:microphone-change@document->coplan--dictation#microphoneChanged coplan:composer-close@document->coplan--dictation#closed coplan:dictation-start@document->coplan--dictation#otherStarted">
      <%= text_area_tag local_assigns.fetch(:field_name, "comment_thread[body_markdown]"), local_assigns[:body],
            id: local_assigns.fetch(:field_id, "comment_thread_body_markdown"),
            rows: 3, placeholder: local_assigns.fetch(:placeholder, t("coplan.discussions.messages.write_a_comment")), required: true,
            aria: { label: label }, class: "composer__input",
            data: { "coplan--comment-form-target": "input", "coplan--dictation-target": "input",
                    action: "keydown->coplan--comment-form#link paste->coplan--comment-form#pasteLink" }.merge(local_assigns.fetch(:textarea_data, {})) %>
      <div class="composer__status" role="status" aria-live="polite" data-coplan--dictation-target="status"></div>
      <div class="comment-form__error text-sm" role="alert" id="<%= local_assigns.fetch(:error_id, "new-comment-form-error") %>"></div>
      <div class="composer__toolbar">
        <div class="composer__voice">
        <button type="button" class="composer__dictate" title="<%= t("coplan.discussions.dictate_a_comment") %>" data-coplan--dictation-target="button" data-action="coplan--dictation#toggle" aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="9" y="2" width="6" height="13" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/></svg>
          <span data-coplan--dictation-target="label"><%= t("coplan.discussions.dictate") %></span>
        </button>
        <%= render "coplan/plans/microphone_settings" %>
        </div>
        <div class="composer__send-actions">
          <% if local_assigns.fetch(:cancel_action, "coplan--text-selection#cancelComment").present? %>
            <button type="button" class="composer__cancel" aria-label="<%= local_assigns.fetch(:cancel_label, t("coplan.common.cancel")) %>"
                    data-action="<%= local_assigns.fetch(:cancel_action, "coplan--text-selection#cancelComment") %>"><%= t("coplan.common.cancel") %></button>
          <% end %>
          <button type="submit" class="btn <%= local_assigns.fetch(:submit_class, 'btn--primary') %> btn--sm composer__submit" data-turbo-submits-with="<%= local_assigns[:editing] ? t("coplan.discussions.messages.saving_pending") : t("coplan.discussions.messages.posting_pending") %>"><%= submit_label %> <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 13V3M3 8l5-5 5 5"/></svg></button>
        </div>
      </div>
    </div>
  </div>
  <div class="composer__link" popover="manual" role="dialog" aria-label="<%= t("coplan.discussions.insert_link") %>" hidden
       data-coplan--comment-form-target="linkPanel" data-action="keydown->coplan--comment-form#linkKeydown">
    <label>
      <span data-coplan--comment-form-target="linkLabel"><%= t("coplan.discussions.search_or_paste_a_link") %></span>
      <span role="alert" hidden data-coplan--comment-form-target="linkError"><%= t("coplan.discussions.enter_a_uri_such_as") %></span>
      <input aria-label="<%= t("coplan.discussions.search_or_paste_a_link") %>" type="text" placeholder="<%= t("coplan.discussions.search_coplan_or_paste_a_pending") %>" autocomplete="off"
             data-coplan--comment-form-target="linkUrl" data-action="input->coplan--comment-form#searchLinks">
    </label>
    <div class="composer__link-results" aria-live="polite" data-coplan--comment-form-target="linkResults"></div>
    <div class="composer__send-actions">
      <button type="button" class="composer__cancel" data-action="coplan--comment-form#cancelLink"><%= t("coplan.discussions.cancel_link") %></button>
      <button type="button" class="btn btn--primary btn--sm" data-action="coplan--comment-form#applyLink"><%= t("coplan.discussions.insert_link") %></button>
    </div>
  </div>
</div>
