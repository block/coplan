<aside class="source-comments comment-form comment-window" popover="manual" role="dialog" aria-label="Element comments"
       data-controller="coplan--composer"
       data-coplan--source-comments-target="panel"
       data-action="input->coplan--composer#fitDraft focusin->coplan--composer#fitDraft resize@window->coplan--composer#constrain toggle->coplan--composer#toggled coplan:composer-close->coplan--composer#closed toggle->coplan--source-comments#panelToggled focusin@document->coplan--source-comments#browseFocus pointerdown@document->coplan--source-comments#dismissFromOutside:capture keydown@document->coplan--source-comments#discussionKey:capture turbo:submit-end->coplan--source-comments#submitted resize@window->coplan--source-comments#positionPanel scroll@document->coplan--source-comments#positionPanel:capture">
  <%= render "coplan/comment_threads/window_controls", close_action: "coplan--source-comments#dismiss", viewer_id: current_user&.id %>
  <div data-coplan--source-comments-target="discussions"
       data-controller="coplan--viewer-role" data-coplan--viewer-role-viewer-id-value="<%= current_user&.id %>"></div>
  <%= form_with url: plan_comment_threads_path(plan), method: :post, data: { controller: "coplan--comment-submit", action: "turbo:submit-start->coplan--comment-submit#started turbo:before-fetch-response->coplan--comment-submit#response turbo:fetch-request-error->coplan--comment-submit#failed turbo:submit-end->coplan--comment-submit#finished", "coplan--source-comments-target": "composer" } do %>
    <input type="hidden" name="comment_thread[source_token]" data-coplan--source-comments-target="token">
    <div class="comment-form__anchor">
      <span class="text-sm text-muted">Commenting on:</span>
      <blockquote class="comment-form__quote" data-coplan--source-comments-target="quote"></blockquote>
    </div>
    <%= render "coplan/comment_threads/composer_fields",
          plan: plan, field_id: "source-comment-body", error_id: "source-comment-error",
          textarea_data: { "coplan--source-comments-target": "body" }, cancel_action: nil %>
  <% end %>
</aside>

<button type="button" hidden class="btn btn--secondary source-comments-outdated"
        data-coplan--source-comments-target="outdated"
        data-action="coplan--source-comments#showOutdated">Outdated element comments</button>
