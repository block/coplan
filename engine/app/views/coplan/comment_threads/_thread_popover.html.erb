<div class="thread-popover-data"
     id="<%= dom_id(thread) %>"
     data-anchor-digest="<%= Digest::SHA256.hexdigest(plan.current_content.to_s) if thread.anchor_kind.present? && thread.anchor_revision == plan.current_revision %>"
     data-anchor-kind="<%= thread.anchor_kind %>"
     data-anchor-start="<%= thread.anchor_start %>"
     data-anchor-end="<%= thread.anchor_end %>"
     data-out-of-date="<%= thread.out_of_date? %>"
     data-anchor-text="<%= thread.anchor_text %>"
     data-anchor-occurrence="<%= thread.anchor_occurrence_index %>"
     data-anchor-start="<%= thread.anchor_start %>"
     data-anchor-end="<%= thread.anchor_end %>"
     data-thread-out-of-date="<%= thread.out_of_date? %>"
     data-thread-id="<%= thread.id %>"
     data-thread-status="<%= thread.status %>"
     data-plan-author-id="<%= plan.created_by_user_id %>"
     data-thread-author-id="<%= thread.created_by_user_id %>">

  <div popover="auto" id="<%= dom_id(thread) %>_popover" class="thread-popover comment-window" data-controller="coplan--composer" data-action="input->coplan--composer#fitDraft focusin->coplan--composer#fitDraft resize@window->coplan--composer#constrain toggle->coplan--composer#toggled coplan:composer-close->coplan--composer#closed">
    <%= render "coplan/comment_threads/window_controls", thread: thread, plan: plan %>
    <% if thread.closed? || thread.out_of_date? %>
    <div class="thread-popover__header">
      <% if thread.closed? %>
        <span class="badge badge--<%= thread.status %>"><%= thread.status %></span>
      <% end %>
      <% if thread.out_of_date? %>
        <span class="badge badge--archived">out of date</span>
      <% end %>
    </div>
    <% end %>

    <% if thread.anchored? %>
      <blockquote class="thread-popover__quote"><%= thread.anchor_preview %></blockquote>
    <% end %>

    <div class="thread-popover__comments" id="<%= dom_id(thread, :comments) %>">
      <% thread.comments.each do |comment| %>
        <%= render partial: "coplan/comments/comment", locals: { comment: comment } %>
      <% end %>
    </div>

    <%# Action visibility is gated client-side by coplan--viewer-role: broadcasts
        re-render this partial for every subscriber with no current_user, so the
        server can't decide who may act. The buttons are always rendered and the
        viewer's role (plan author / thread author) reveals them via CSS. %>
    <% if thread.open? %>
      <div class="thread-popover__reply">
        <%= render "coplan/comment_threads/reply_form", thread: thread, plan: plan %>
      </div>

    <% end %>
  </div>
</div>
