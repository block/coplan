<div class="review-table-scroll" tabindex="0" role="region" aria-label="<%= t("coplan.reviews.reviewer_decisions") %>">
  <table class="review-table" aria-label="<%= t("coplan.reviews.reviewers") %>">
    <thead><tr><th scope="col"><%= t("coplan.reviews.reviewer") %></th><th scope="col"><%= t("coplan.reviews.review") %></th><th scope="col"><%= t("coplan.reviews.decision") %></th><th scope="col"><%= t("coplan.reviews.version") %></th><th scope="col"><%= t("coplan.common.actions") %></th></tr></thead>
    <tbody>
      <% active_requests.sort_by { |request| [Coplan::ReviewRequest::REQUIREMENTS.index(request.requirement), request.reviewer.name.downcase, request.id] }.each do |request| %>
        <% response = request.recorded_response %>
        <% approval = request.latest_approval %>
        <tr class="review-person" data-reviewer-id="<%= request.reviewer_id %>">
          <td><div class="review-table__person"><%= user_avatar(request.reviewer) %><strong><%= request.reviewer.name %></strong></div></td>
          <td><span class="review-table__requirement"><%= review_requirement_label(request.requirement) %></span></td>
          <td><span class="review-state<%= ' review-state--approved' if request.review_status == 'approved' %><%= ' review-state--attention' if request.pending? && request.reviewer_id == current_user.id %>"><span aria-hidden="true"><%= request.pending? ? "◷" : request.review_status == "approved" ? "✓" : "↩" %></span><span class="review-person__meta"><%= request.pending? ? (request.reset_reason == "content_changed" ? t("coplan.reviews.messages.content_changed_review_again") : t("coplan.reviews.review_requested")) : review_decision_label(request.review_status) %><%= t("coplan.reviews.messages.agent") if response&.actor_type == "local_agent" %></span></span></td>
          <td><% if !request.pending? && response %><span class="review-version">v<%= response.plan_version.revision %></span><% if response.plan_version_id != plan.current_plan_version_id %> <span class="text-muted"><%= t("coplan.interface.current_version", revision: plan.current_revision) %></span><% end %><% else %><span class="text-muted" aria-label="<%= t("coplan.reviews.not_reviewed_yet") %>">—</span><% end %></td>
          <td class="review-table__actions">
            <% if !request.pending? && request.reviewer_id == current_user.id %><button type="button" class="review-log__link review-reopen" aria-label="<%= t("coplan.reviews.change_decision") %>" title="<%= t("coplan.reviews.change_decision") %>" data-action="coplan--review-tray#reconsider"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6.1 7a7 7 0 0 1 11.6-1L20 9M4 15l2.3 3A7 7 0 0 0 17.9 17"/></svg></button><% end %>
            <% if approval && approval.plan_version.revision != plan.current_revision %><button type="button" class="review-log__link" data-action="coplan--review-tray#compare" data-url="<%= compare_plan_review_request_path(plan, request, response_id: approval.id) %>"><%= t("coplan.reviews.compare") %></button><% end %>
          </td>
        </tr>
      <% end %>
      <% if active_requests.empty? %><tr><td colspan="5" class="text-muted"><%= t("coplan.reviews.no_reviewers_yet") %></td></tr><% end %>
    </tbody>
  </table>
</div>
