<%= content_tag :div, id: dom_id(notification), class: "notifications-list__item #{'notifications-list__item--read' if notification.read?}" do %>
  <%= link_to plan_browse_path(notification.plan, thread: notification.comment_thread_id), class: "inbox-row #{'inbox-row--unread' unless notification.read?}", data: { turbo_frame: "_top", turbo_prefetch: true } do %>
    <div class="inbox-row__main">
      <strong><% unless notification.read? %><span class="review-task-dot" aria-hidden="true"></span><span class="sr-only"><%= t("coplan.reviews.unread") %> </span><% end %><%= notification.reason == "review_requested" ? t("coplan.reviews.messages.your_review_was_requested") : t("coplan.reviews.messages.a_review_response_was_recorded") %></strong>
      <div><%= notification.plan.title %></div>
      <div class="text-sm text-muted"><%= relative_ui_time(notification.created_at) %></div>
    </div>
  <% end %>
<% end %>
