<% requests = plan.review_requests.includes(:reviewer, :requested_by_user, :requested_plan_version, review_responses: [ :plan_version, :user ]).order(:requested_at).to_a %>
<% active_requests = requests.reject { |request| request.status == "withdrawn" } %>
<% own_request = active_requests.find { |request| request.reviewer_id == current_user.id } %>
<div id="plan-review-controls" data-controller="coplan--review-tray"
     data-coplan--review-tray-url-value="<%= plan_review_requests_path(plan) %>"
     data-coplan--review-tray-search-url-value="<%= search_users_path %>"
     data-action="coplan:reviews-changed->coplan--review-tray#refresh coplan:manage-reviews@document->coplan--review-tray#openReviews coplan:content-updated@document->coplan--review-tray#refresh coplan:editor-saved@document->coplan--review-tray#refresh resize@window->coplan--review-tray#positionAssignment keydown.esc@document->coplan--review-tray#escape">
  <span hidden><%= render "coplan/reviews/indicator", plan: plan, update: true %></span>
  <%= render "coplan/reviews/log", plan: plan, requests: requests, active_requests: active_requests %>
  <%= render "coplan/reviews/management", plan: plan, requests: requests, active_requests: active_requests %>
  <% if own_request && plan.current_content.present? %>
    <section class="review-tray" data-completed="<%= !own_request.pending? %>" popover="manual" aria-label="Your review">
      <div class="review-tray__discussion" data-coplan--review-tray-target="discussion" hidden>
        <div class="review-tray__heading"><strong>What would you like changed?</strong><button type="button" class="btn btn--ghost btn--sm" aria-label="Collapse feedback" data-action="coplan--review-tray#collapse">⌄</button></div>
        <%= form_with url: respond_plan_review_request_path(plan, own_request), data: { action: "submit->coplan--review-tray#post", "coplan--review-tray-target": "commentForm" } do %>
          <%= render "coplan/comment_threads/composer_fields", plan: plan, label: "Public review comment",
                field_id: "review-discussion-body", error_id: "review-discussion-error", cancel_action: "coplan--review-tray#collapse",
                field_name: "review_response[note]", submit_label: "Request changes", submit_class: "btn--secondary", placeholder: "Describe the adjustments, questions, or wording you want addressed…" %>
        <% end %>
        <p class="text-sm text-muted review-tray__public">Public · Anyone who can read this plan can join the discussion.</p>
      </div>
      <div class="review-tray__bar">
        <div class="review-tray__status" data-review-status>
          <% response = own_request.review_responses.first %>
          <% approval = own_request.latest_approval %>
          <div><% unless own_request.pending? %><span class="review-result-icon<%= ' review-result-icon--approved' if own_request.status == 'approved' %>" aria-hidden="true"><%= own_request.status == "approved" ? "✓" : "↩" %></span><% end %><% if own_request.pending? %><span class="review-task-dot" aria-hidden="true"></span><% end %><strong><%= own_request.pending? ? "Your review is requested" : "#{own_request.status == 'approved' ? 'Approved' : 'Changes requested on'} v#{response&.plan_version&.revision}" %></strong><% if own_request.pending? %><small><%= own_request.requirement.humanize %></small><% end %></div>
          <% if !own_request.pending? && response&.comment_thread_id %><button type="button" class="review-log__link review-feedback-link" data-action="coplan--review-tray#openThread" data-thread-id="<%= response.comment_thread_id %>">View feedback</button><% end %>
          <% if approval && approval.plan_version.revision != plan.current_revision %><button type="button" class="btn btn--ghost btn--sm" data-action="coplan--review-tray#compare" data-url="<%= compare_plan_review_request_path(plan, own_request, response_id: approval.id) %>">Changes since approval</button><% end %>
        </div>
        <div class="review-tray__actions">
          <span data-review-decision-actions data-recorded="<%= !own_request.pending? %>">
            <% unless own_request.pending? %><button type="button" class="btn btn--secondary btn--sm review-reconsider" data-action="coplan--review-tray#reconsider">Change decision</button><% end %>
            <span class="review-decision-choices">
              <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--review-tray#requestChanges" data-url="<%= respond_plan_review_request_path(plan, own_request) %>" aria-expanded="false" data-coplan--review-tray-target="changeButton">Request changes</button>
              <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--review-tray#confirmApproval" data-url="<%= respond_plan_review_request_path(plan, own_request) %>">Approve</button>
            </span>
            <% unless own_request.pending? %><button type="button" class="review-dismiss" aria-label="Dismiss review confirmation" data-action="coplan--review-tray#dismissRecorded">×</button><% end %>
          </span>
        </div>
      </div>
      <div class="review-tray__notice" role="status" aria-live="polite" data-coplan--review-tray-target="notice"></div>
    </section>
  <% end %>
  <dialog class="review-dialog review-confirmation" data-coplan--review-tray-target="approval" aria-labelledby="approval-title">
    <h2 id="approval-title">Approve this version?</h2>
    <p>By approving, you confirm:</p>
    <p data-coplan--review-tray-target="approvalStatement">I have read this version and agree with all of its content.</p>
    <p class="text-sm text-muted">AI agents can see this sign-off and use it when planning their next steps. If you want any adjustment, clarification, or cleaner wording, request changes instead. Approval grants no permissions or authority to execute the plan.</p>
    <form data-action="submit->coplan--review-tray#approve">
      <label for="approval-note">Public note <span class="text-muted">(optional)</span></label><textarea id="approval-note" rows="2" data-coplan--review-tray-target="approvalNote"></textarea>
      <p class="review-error" role="alert" data-coplan--review-tray-target="approvalError"></p>
      <div class="review-dialog__actions"><button type="button" class="btn btn--secondary btn--sm" data-action="coplan--review-tray#closeApproval" autofocus>Cancel</button><button type="submit" class="btn btn--secondary btn--sm" data-coplan--review-tray-target="approveButton">Approve version</button></div>
    </form>
  </dialog>
  <dialog class="review-dialog review-comparison" data-coplan--review-tray-target="comparison" aria-label="Changes since approval"><div class="review-dialog__heading"><h2>Changes since approval</h2><button type="button" class="btn btn--ghost btn--sm" aria-label="Close comparison" data-action="coplan--review-tray#closeComparison">×</button></div><div data-coplan--review-tray-target="diff"></div></dialog>
</div>
