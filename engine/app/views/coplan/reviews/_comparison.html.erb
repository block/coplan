<p class="text-sm text-muted"><%= t("coplan.reviews.version") %> <%= from.revision %> → <%= to.revision %> · <%= t("coplan.interface.diff_counts", added: diff.to_s(:text).lines.count { |line| line.start_with?("+") }, removed: diff.to_s(:text).lines.count { |line| line.start_with?("-") }) %></p>
<% if from.content_sha256 == to.content_sha256 %><p><%= t("coplan.reviews.no_document_text_changed_since") %></p><% else %><div class="diff-view"><%= diff.to_s(:html).html_safe %></div><% end %>
<p class="text-sm text-muted"><%= t("coplan.reviews.the_earlier_approval_remains_recorded") %></p>
