<% if tasks.any? %>
  <section class="review-tasks" aria-label="<%= t("coplan.reviews.your_review_tasks") %>">
    <h2><%= t("coplan.reviews.reviews_requested") %></h2>
    <% tasks.each do |task| %>
      <%= link_to plan_browse_path(task.plan), class: "review-tasks__item", data: { turbo_frame: "_top" } do %>
        <span class="review-task-dot" aria-hidden="true"></span>
        <span><%= task.plan.title %><small><%= t("coplan.interface.requested_your_review", name: task.requested_by_user.name) %> · <%= review_requirement_label(task.requirement) %></small></span>
        <span class="text-sm text-muted"><%= t("coplan.reviews.review_pending") %></span>
      <% end %>
    <% end %>
  </section>
<% end %>
