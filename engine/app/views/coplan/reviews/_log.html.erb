<section class="plan-footnote review-log-panel" id="footnote-approvals" data-plan-section="approvals" tabindex="-1" aria-labelledby="review-log-title">
  <details class="review-log-details document-support__disclosure" data-controller="coplan--support-disclosure" data-action="toggle->coplan--support-disclosure#remember">
    <summary class="review-log-panel__header document-support__heading"><span class="document-support__chevron" aria-hidden="true">›</span><h2 class="plan-footnote__title" id="review-log-title"><%= t("coplan.common.reviews") %></h2><span class="review-log-panel__summary" data-review-log-summary><span><%= t("coplan.display.reviewers", count: active_requests.size) %><%= t("coplan.reviews.messages.count_awaiting_review", count: active_requests.count(&:pending?)) if active_requests.any?(&:pending?) %></span></span></summary>
    <div class="review-log-panel__columns document-support__content">
      <p class="text-sm text-muted"><%= t("coplan.reviews.reviews_cover_the_markdown_source") %></p>
      <%= render "coplan/reviews/roster", plan: plan, active_requests: active_requests, manage: false %>
      <div class="review-log-panel__tools"><button type="button" class="btn btn--secondary btn--sm" data-action="coplan--review-tray#openActivity"><%= t("coplan.reviews.view_activity") %> <span aria-hidden="true">↗</span></button></div>
    </div>
  </details>
  <% if allowed_to?(plan, :update?) %><button type="button" class="section-add document-support__add" aria-label="<%= t("coplan.common.manage_reviewers") %>" title="<%= t("coplan.common.manage_reviewers") %>" data-action="coplan--review-tray#openReviews">+</button><% end %>
</section>
