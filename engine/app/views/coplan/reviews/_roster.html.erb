  <section class="review-roster" aria-label="Reviewers" <%= manage ? "data-review-assignments" : "data-review-roster" %>>
    <% if !manage %>
      <%= render "coplan/reviews/table", plan: plan, active_requests: active_requests %>
    <% else %>
    <% if active_requests.empty? %><div class="review-empty"><span class="review-empty__icon" aria-hidden="true">◎</span><p>No reviewers yet</p></div><% end %>
        <% active_requests.sort_by { |request| [CoPlan::ReviewRequest::REQUIREMENTS.index(request.requirement), request.reviewer.name.downcase, request.id] }.each do |request| %>
          <% requirement = request.requirement %>
          <% approval = request.latest_approval %>
          <div class="review-person" data-reviewer-id="<%= request.reviewer_id %>">
            <%= user_avatar(request.reviewer, size: "md") %>
            <div class="review-person__info">
              <strong><%= request.reviewer.name %></strong>
              <span class="review-person__meta"><span class="review-person__requirement"><%= requirement.humanize %></span> · <% if request.pending? %>Review requested<% elsif request.status == "changes_requested" %>Changes requested on v<%= request.review_responses.first&.plan_version&.revision %><% else %>Approved v<%= approval&.plan_version&.revision %><% end %></span>
            </div>
            <span class="review-state<%= ' review-state--approved' if request.status == 'approved' %><%= ' review-state--attention' if request.pending? && request.reviewer_id == current_user.id %>"><span aria-hidden="true"><%= request.pending? ? "◷" : request.status == "approved" ? "✓" : "↩" %></span> <%= request.pending? ? "Pending" : request.status.humanize %></span>
            <% if manage && allowed_to?(plan, :update?) %>
              <span class="review-person__actions" data-controller="coplan--menu">
                <button type="button" class="review-person__menu-button" aria-label="Actions for <%= request.reviewer.name %>" title="Actions for <%= request.reviewer.name %>" popovertarget="review-menu-<%= request.id %>" data-coplan--menu-target="trigger"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg></button>
                <div id="review-menu-<%= request.id %>" class="menu review-person__menu" popover="auto" data-coplan--menu-target="menu" data-action="beforetoggle->coplan--menu#reposition" aria-label="Review actions for <%= request.reviewer.name %>">
                  <button type="button" class="menu__item" data-action="coplan--review-tray#requestAgain coplan--menu#close" data-url="<%= plan_review_request_path(plan, request) %>"><%= request.status == "changes_requested" ? "Ready for another look" : "Request another review" %></button>
                  <button type="button" class="menu__item" data-action="coplan--review-tray#changeRequirement coplan--menu#close" data-url="<%= plan_review_request_path(plan, request) %>" data-requirement="<%= requirement == 'required' ? 'optional' : 'required' %>">Make <%= requirement == 'required' ? 'optional' : 'required' %></button>
                  <% if approval && approval.plan_version.revision != plan.current_revision %><button type="button" class="menu__item" data-action="coplan--review-tray#compare coplan--menu#close" data-url="<%= compare_plan_review_request_path(plan, request, response_id: approval.id) %>">Changes since approval</button><% end %>
                  <div class="menu__separator" role="separator"></div>
                  <button type="button" class="menu__item" data-action="coplan--review-tray#withdraw coplan--menu#close" data-url="<%= plan_review_request_path(plan, request) %>">Remove request</button>
                </div>
              </span>
            <% elsif approval && approval.plan_version.revision != plan.current_revision %>
              <button type="button" class="review-log__link" data-action="coplan--review-tray#compare" data-url="<%= compare_plan_review_request_path(plan, request, response_id: approval.id) %>">Compare</button>
            <% end %>
          </div>
        <% end %>
    <% end %>
  </section>
