  <section class="review-roster" aria-label="<%= t("coplan.reviews.reviewers") %>" <%= manage ? "data-review-assignments" : "data-review-roster" %>>
    <% if !manage %>
      <%= render "coplan/reviews/table", plan: plan, active_requests: active_requests %>
    <% else %>
    <% if active_requests.empty? %><div class="review-empty"><span class="review-empty__icon" aria-hidden="true">◎</span><p><%= t("coplan.reviews.no_reviewers_yet") %></p></div><% end %>
        <% active_requests.sort_by { |request| [Coplan::ReviewRequest::REQUIREMENTS.index(request.requirement), request.reviewer.name.downcase, request.id] }.each do |request| %>
          <% requirement = request.requirement %>
          <% approval = request.latest_approval %>
          <div class="review-person" data-reviewer-id="<%= request.reviewer_id %>">
            <%= user_avatar(request.reviewer, size: "md") %>
            <div class="review-person__info">
              <strong><%= request.reviewer.name %></strong>
              <span class="review-person__meta"><span class="review-person__requirement"><%= review_requirement_label(requirement) %></span> · <% if request.pending? %><%= t("coplan.reviews.review_requested") %><% elsif request.review_status == "changes_requested" %><%= t("coplan.interface.changes_version", revision: request.recorded_response&.plan_version&.revision) %><% else %><%= t("coplan.interface.approved_version", revision: request.recorded_response&.plan_version&.revision) %><%= t("coplan.reviews.messages.agent") if request.recorded_response&.actor_type == "local_agent" %><% end %><% if request.recorded_response && request.recorded_response.plan_version_id != plan.current_plan_version_id %> · <%= t("coplan.interface.current_version", revision: plan.current_revision) %><% end %></span>
            </div>
            <span class="review-state<%= ' review-state--approved' if request.review_status == 'approved' %><%= ' review-state--attention' if request.pending? && request.reviewer_id == current_user.id %>"><span aria-hidden="true"><%= request.pending? ? "◷" : request.review_status == "approved" ? "✓" : "↩" %></span> <%= request.pending? ? t("coplan.reviews.messages.pending") : review_decision_label(request.review_status) %></span>
            <% if manage && allowed_to?(plan, :update?) %>
              <span class="review-person__actions" data-controller="coplan--menu">
                <button type="button" class="review-person__menu-button" aria-label="<%= t("coplan.interface.reviewer_actions", name: request.reviewer.name) %>" title="<%= t("coplan.interface.reviewer_actions", name: request.reviewer.name) %>" popovertarget="review-menu-<%= request.id %>" data-coplan--menu-target="trigger"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg></button>
                <div id="review-menu-<%= request.id %>" class="menu review-person__menu" popover="auto" data-coplan--menu-target="menu" data-action="beforetoggle->coplan--menu#reposition" aria-label="<%= t("coplan.interface.review_actions", name: request.reviewer.name) %>">
                  <button type="button" class="menu__item" data-action="coplan--review-tray#requestAgain coplan--menu#close" data-url="<%= plan_review_request_path(plan, request) %>"><%= request.review_status == "changes_requested" ? t("coplan.reviews.messages.ready_for_another_look") : t("coplan.reviews.messages.request_another_review") %></button>
                  <button type="button" class="menu__item" data-action="coplan--review-tray#changeRequirement coplan--menu#close" data-url="<%= plan_review_request_path(plan, request) %>" data-requirement="<%= requirement == 'required' ? 'optional' : 'required' %>"><%= requirement == "required" ? t("coplan.interface.make_optional") : t("coplan.interface.make_required") %></button>
                  <% if approval && approval.plan_version.revision != plan.current_revision %><button type="button" class="menu__item" data-action="coplan--review-tray#compare coplan--menu#close" data-url="<%= compare_plan_review_request_path(plan, request, response_id: approval.id) %>"><%= t("coplan.reviews.changes_since_approval") %></button><% end %>
                  <div class="menu__separator" role="separator"></div>
                  <button type="button" class="menu__item" data-action="coplan--review-tray#withdraw coplan--menu#close" data-url="<%= plan_review_request_path(plan, request) %>"><%= t("coplan.reviews.remove_reviewer") %></button>
                </div>
              </span>
            <% elsif approval && approval.plan_version.revision != plan.current_revision %>
              <button type="button" class="review-log__link" data-action="coplan--review-tray#compare" data-url="<%= compare_plan_review_request_path(plan, request, response_id: approval.id) %>"><%= t("coplan.reviews.compare") %></button>
            <% end %>
          </div>
        <% end %>
    <% end %>
  </section>
