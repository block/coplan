  <section class="review-history" aria-label="<%= t("coplan.reviews.review_activity") %>">
    <div class="review-log" data-review-history>
      <% logged_request_ids = request_events.select { |event| event.event_type == "review_requested" }.map(&:after_value) %>
      <% activity = request_events.map { |event| [event.created_at, :request_event, event] } %>
      <% activity += requests.flat_map { |request| (logged_request_ids.include?(request.id) ? [] : [[request.requested_at, :request, request]]) + request.review_responses.map { |response| [response.created_at, :response, response] } } %>
      <% activity.sort_by!(&:first).reverse! %>
      <% if activity.empty? %><p class="review-log__empty"><%= t("coplan.reviews.no_review_activity_yet") %></p><% end %>
      <% activity.each do |at, kind, item| %>
        <% actor = kind == :request_event ? item.actor_user : kind == :request ? item.requested_by_user : item.user %>
        <article class="review-log__entry">
          <div class="review-log__avatar"><%= user_avatar(actor, size: "sm") %></div>
          <div class="review-log__body">
            <p class="review-log__event"><strong><%= kind != :request && item.actor_type == "local_agent" ? t("coplan.reviews.messages.agent_name_via_name", agent_name: item.agent_name, name: actor.name) : actor.name %></strong>
              <% if kind == :response %>
                <%= item.decision == "approved" ? t("coplan.interface.approved_verb") : t("coplan.reviews.messages.requested_changes_on") %>
              <% else %>
                <% if kind == :request_event && item.event_type == "review_removed" %>
                  <%= t("coplan.interface.removed_reviewer") %>
                <% elsif kind == :request_event && item.event_type == "review_withdrawn" %>
                  <%= t("coplan.interface.withdrew_review") %>
                <% else %>
                  <%= t("coplan.interface.requested_review") %>
                <% end %>
                <strong><%= kind == :request_event ? item.metadata["reviewer_name"] : item.reviewer.name %></strong>
              <% end %>
              <% if kind == :response %><%= link_to t("coplan.reviews.messages.v_revision_markdown_snapshot", revision: item.plan_version.revision), plan_version_browse_path(item.review_request.plan, item.plan_version), class: "review-version" %><%= t("coplan.reviews.messages.historical_decision") unless item.review_request.effective_response&.id == item.id %><% end %>
            </p>
            <time datetime="<%= at.iso8601 %>" title="<%= l(at, format: :long) %>"><%= l(at, format: :short) %></time>
            <% if kind == :response && item.note.present? %><p class="review-log__note"><%= item.note %></p><% end %>
            <% if kind == :response && feedback_thread_ids.include?(item.comment_thread_id) %><button type="button" class="review-log__link" data-action="coplan--review-tray#openThread" data-thread-id="<%= item.comment_thread_id %>"><%= t("coplan.common.open_discussion") %> <span aria-hidden="true">↗</span></button><% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
