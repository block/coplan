  <section class="review-history" aria-label="Review activity">
    <div class="review-log" data-review-history>
      <% logged_request_ids = request_events.select { |event| event.event_type == "review_requested" }.map(&:after_value) %>
      <% activity = request_events.map { |event| [event.created_at, :request_event, event] } %>
      <% activity += requests.flat_map { |request| (logged_request_ids.include?(request.id) ? [] : [[request.requested_at, :request, request]]) + request.review_responses.map { |response| [response.created_at, :response, response] } } %>
      <% activity.sort_by!(&:first).reverse! %>
      <% if activity.empty? %><p class="review-log__empty">No review activity yet.</p><% end %>
      <% activity.each do |at, kind, item| %>
        <% actor = kind == :request_event ? item.actor_user : kind == :request ? item.requested_by_user : item.user %>
        <article class="review-log__entry">
          <div class="review-log__avatar"><%= user_avatar(actor, size: "sm") %></div>
          <div class="review-log__body">
            <p class="review-log__event"><strong><%= kind != :request && item.actor_type == "local_agent" ? "#{item.agent_name} (via #{actor.name})" : actor.name %></strong>
              <% if kind != :response %><%= kind == :request_event && item.event_type == "review_withdrawn" ? "withdrew the review request for" : "requested a review from" %> <strong><%= kind == :request_event ? item.metadata["reviewer_name"] : item.reviewer.name %></strong><% else %><%= item.decision == "approved" ? "approved" : "requested changes on" %><% end %>
              <% if kind == :response %><%= link_to "v#{item.plan_version.revision} · Markdown snapshot", plan_version_browse_path(item.review_request.plan, item.plan_version), class: "review-version" %><%= " · Historical decision" unless item.review_request.effective_response&.id == item.id %><% end %>
            </p>
            <time datetime="<%= at.iso8601 %>" title="<%= l(at, format: :long) %>"><%= l(at, format: :short) %></time>
            <% if kind == :response && item.note.present? %><p class="review-log__note"><%= item.note %></p><% end %>
            <% if kind == :response && feedback_thread_ids.include?(item.comment_thread_id) %><button type="button" class="review-log__link" data-action="coplan--review-tray#openThread" data-thread-id="<%= item.comment_thread_id %>">Open discussion <span aria-hidden="true">↗</span></button><% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
