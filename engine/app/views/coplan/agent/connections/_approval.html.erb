<div class="card connection-approval" role="region" aria-label="<%= t("coplan.agent_access.connection_approval") %>">
  <% if @connection.nil? %>
    <% if @user_code.present? %><p role="alert"><%= t("coplan.agent_access.that_connection_code_is_not") %></p><% end %>
    <h2><%= t("coplan.agent_access.enter_your_connection_code") %></h2>
    <p><%= t("coplan.agent_access.start_setup_in_your_local") %></p>
    <%= form_with url: agent_connect_path, method: :get do |f| %>
      <div class="form-group">
        <%= f.label :user_code, t("coplan.agent_access.messages.connection_code") %>
        <%= f.text_field :user_code, value: @user_code, required: true, maxlength: 20, autocomplete: "off", spellcheck: false %>
      </div>
      <%= f.submit t("coplan.agent_access.messages.continue"), class: "btn btn--primary", data: { turbo_submits_with: t("coplan.agent_access.messages.checking_pending") } %>
    <% end %>
  <% elsif @connection.expired? %>
    <h2><%= t("coplan.agent_access.connection_request_expired") %></h2>
    <p><%= t("coplan.agent_access.no_new_access_can_be") %></p>
  <% elsif @connection.status != "pending" %>
    <div role="status">
      <% if @connection.user_id != current_user&.id %>
        <h2><%= t("coplan.agent_access.this_request_is_no_longer") %></h2>
      <% elsif @connection.status == "denied" %>
        <h2><%= t("coplan.agent_access.connection_declined") %></h2>
        <p><%= t("coplan.agent_access.your_local_agent_will_receive") %></p>
      <% else %>
        <h2><%= t("coplan.agent_access.connection_approved") %></h2>
        <p><%= t("coplan.agent_access.return_to_your_local_agent") %></p>
        <%= link_to t("coplan.agent_access.messages.agent_access_settings"), settings_root_path, data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  <% elsif !signed_in? %>
    <h2><%= t("coplan.agent_access.sign_in_to_approve_this") %></h2>
    <p><%= t("coplan.agent_access.sign_in_in_a_new") %></p>
    <% if Coplan.configuration.sign_in_path.present? %>
      <%= link_to t("coplan.common.messages.sign_in"), Coplan.configuration.sign_in_path, target: "_blank", rel: "noopener noreferrer", class: "btn btn--primary" %>
    <% end %>
    <%= link_to t("coplan.agent_access.messages.continue_after_signing_in"), agent_connect_path(user_code: @user_code), class: "btn btn--secondary" %>
  <% else %>
    <h2><%= t("coplan.agent_access.allow_this_computer_to_use") %></h2>
    <p><%= t("coplan.common.signed_in_as") %> <strong><%= current_user.name %></strong><% if current_user.email.present? %> (<%= current_user.email %>)<% end %>.</p>
    <p><%= t("coplan.agent_access.connection_name_reported_by_your") %> <strong><%= @connection.name %></strong></p>
    <p class="connection-code"><code><%= @user_code %></code></p>
    <p><%= t("coplan.agent_access.this_lets_local_tools_read") %></p>
    <p><%= t("coplan.agent_access.only_approve_a_request_you") %></p>
    <% if @confirmation_error %><p role="alert" class="access-error"><%= @confirmation_error %></p><% end %>
    <%= form_with url: agent_connect_path, method: :post do |f| %>
      <%= f.hidden_field :user_code, value: @user_code %>
      <label class="connection-confirm"><%= f.check_box :confirm_code, required: true %> <%= t("coplan.agent_access.this_matches_the_code_shown") %></label>
      <%= f.button t("coplan.agent_access.connect_this_computer"), name: "decision", value: "approve", class: "btn btn--primary", data: { turbo_submits_with: t("coplan.agent_access.messages.connecting_pending") } %>
    <% end %>
    <%= form_with url: agent_connect_path, method: :post, class: "connection-deny" do |f| %>
      <%= f.hidden_field :user_code, value: @user_code %>
      <%= f.button t("coplan.agent_access.messages.decline"), name: "decision", value: "deny", class: "btn btn--secondary", data: { turbo_submits_with: t("coplan.agent_access.messages.declining_pending") } %>
    <% end %>
  <% end %>
</div>
