<% content_for :title, t("coplan.access.messages.personal_api_tokens_coplan") %>
<%= link_to t("coplan.access.messages.settings"), settings_root_path, class: "access-back" %>
<div class="page-header"><h1><%= t("coplan.access.personal_api_tokens") %></h1></div>
<p class="settings-section-subtitle"><%= t("coplan.access.create_one_token_for_your") %></p>
<p id="access-feedback" role="status" class="access-feedback"></p>
<div id="token-reveal">
  <% if flash[:raw_token].present? %>
    <%= render "token_reveal", raw_token: flash[:raw_token] %>
  <% end %>
</div>
<div class="card" id="create-token-form"><%= render "form" %></div>
<%= turbo_frame_tag "personal-tokens", data: { turbo_action: "advance" } do %>
  <%= render "personal_list" %>
<% end %>
