<div class="card access-summary">
  <div class="settings-row">
    <div class="settings-row__main">
      <h2 class="settings-row__label access-heading">Agent access</h2>
      <p class="settings-row__hint"><%= pluralize(@agent_session_count, "agent session") %> with valid access. Sessions expire automatically.</p>
    </div>
    <%= link_to "Manage agent sessions", settings_agent_sessions_path, class: "btn btn--secondary" %>
  </div>
  <% if CoPlan.configuration.agent_connection_enabled? %>
    <div class="settings-row access-summary__advanced">
      <div class="settings-row__main">
        <h2 class="settings-row__label access-heading">Connect your local agent</h2>
        <p class="settings-row__hint">Approve this computer in your browser. Your agent saves its credential locally and mints its own sessions.</p>
      </div>
      <%= link_to "Connect your local agent", agent_setup_path, class: "btn btn--primary" %>
    </div>
  <% end %>
  <div class="settings-row access-summary__advanced">
    <div class="settings-row__main">
      <h2 class="settings-row__label access-heading">Personal API tokens <span class="access-muted">· Advanced</span></h2>
      <p class="settings-row__hint"><%= pluralize(@personal_token_count, "personal token") %> with valid access. Set one up for a local machine when automatic authentication is unavailable.</p>
    </div>
    <%= link_to "Manage personal tokens", settings_tokens_path, class: "btn btn--secondary" %>
  </div>
</div>
