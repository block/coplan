<tr id="<%= dom_id(token) %>">
  <td>
    <strong><%= token.name %></strong>
    <span class="access-detail"><code><%= token.token_prefix %>…</code> · Created <%= token.created_at.strftime("%b %d, %Y") %></span>
  </td>
  <td><span class="badge <%= token.revoked? ? 'badge--neutral' : 'badge--success' %>"><%= token.revoked? ? "Revoked" : "Valid" %></span></td>
  <td><%= render "last_used", token: token %></td>
  <td>
    <% unless token.revoked? %>
      <%= button_to "Revoke", settings_token_path(token), method: :delete, params: { page: @page }, class: "btn btn--danger btn--sm", aria: { label: "Revoke #{token.name}" }, data: { turbo_submits_with: "Revoking…" } %>
    <% end %>
  </td>
</tr>
