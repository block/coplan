<div class="card" id="tokens-card">
  <h2 id="tokens-heading">Your personal tokens</h2>
  <% if @api_tokens.empty? %>
    <p class="access-empty"><%= @page == 1 ? "No personal tokens. If your host authenticates agents automatically, you do not need one." : "No more personal tokens." %></p>
  <% else %>
    <div class="data-table-scroll access-table-scroll" role="region" aria-labelledby="tokens-heading" tabindex="0">
      <table class="data-table access-table">
        <thead><tr><th scope="col">Name</th><th scope="col">Access</th><th scope="col">Last used</th><th scope="col">Actions</th></tr></thead>
        <tbody id="tokens-list"><%= render partial: "token_row", collection: @api_tokens, as: :token %></tbody>
      </table>
    </div>
  <% end %>
  <%= render "pagination" %>
</div>
