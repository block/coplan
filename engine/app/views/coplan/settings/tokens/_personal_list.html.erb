<div class="card" id="tokens-card">
  <h2 id="tokens-heading"><%= t("coplan.access.your_personal_tokens") %></h2>
  <% if @api_tokens.empty? %>
    <p class="access-empty"><%= @page == 1 ? t("coplan.access.messages.no_personal_tokens_if_your") : t("coplan.access.messages.no_more_personal_tokens") %></p>
  <% else %>
    <div class="data-table-scroll access-table-scroll" role="region" aria-labelledby="tokens-heading" tabindex="0">
      <table class="data-table access-table">
        <thead><tr><th scope="col"><%= t("coplan.access.name") %></th><th scope="col"><%= t("coplan.access.access") %></th><th scope="col"><%= t("coplan.access.last_used") %></th><th scope="col"><%= t("coplan.common.actions") %></th></tr></thead>
        <tbody id="tokens-list"><%= render partial: "token_row", collection: @api_tokens, as: :token %></tbody>
      </table>
    </div>
  <% end %>
  <%= render "pagination" %>
</div>
