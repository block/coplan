<% metadata = token.metadata.is_a?(Hash) ? token.metadata : {} %>
<tr id="<%= dom_id(token) %>">
  <td>
    <strong><%= token.agent_name.presence || t("coplan.access.messages.agent_not_reported") %></strong>
    <span class="access-detail"><%= metadata["harness"].presence || t("coplan.access.messages.harness_not_reported") %> · <%= metadata["model"].presence || t("coplan.access.messages.model_not_reported") %></span>
    <span class="access-purpose"><%= token.name %></span>
    <details class="access-details">
      <summary><%= t("coplan.access.details") %></summary>
      <dl>
        <dt><%= t("coplan.access.acting_for") %></dt><dd><%= current_user.name %></dd>
        <dt><%= t("coplan.access.authenticated_through") %></dt><dd><%= token.parent ? t("coplan.access.messages.personal_token_name", name: token.parent.name) : t("coplan.access.messages.host_authentication") %></dd>
        <dt><%= t("coplan.access.harness_version") %></dt><dd><%= metadata["harness_version"].presence || t("coplan.access.messages.not_reported") %></dd>
        <dt><%= t("coplan.access.created") %></dt><dd><time datetime="<%= token.created_at.iso8601 %>"><%= token.created_at.utc.iso8601 %></time></dd>
        <dt><%= t("coplan.access.session_id") %></dt><dd><code><%= token.id %></code></dd>
      </dl>
    </details>
  </td>
  <td>
    <% if token.revoked? %>
      <span class="badge badge--neutral"><%= t("coplan.access.revoked") %></span>
    <% elsif token.expired? %>
      <span class="badge badge--neutral"><%= t("coplan.access.expired") %></span>
    <% elsif token.parent_disabled? %>
      <span class="badge badge--neutral"><%= t("coplan.access.parent_access_ended") %></span>
    <% else %>
      <span class="badge badge--success"><%= t("coplan.access.valid") %></span>
    <% end %>
    <% if token.expires_at %>
      <span class="access-detail"><time datetime="<%= token.expires_at.iso8601 %>" title="<%= token.expires_at.utc.iso8601 %>"><%= token.expired? ? t("coplan.access.messages.expired_expires_at_ago", expires_at: time_ago_in_words(token.expires_at)) : t("coplan.access.messages.expires_in_expires_at", expires_at: time_ago_in_words(token.expires_at)) %></time></span>
    <% end %>
  </td>
  <td><%= render "last_used", token: token %></td>
  <td>
    <% if token.active? && !token.parent_disabled? %>
      <%= button_to t("coplan.access.messages.revoke"), settings_token_path(token), method: :delete, params: { surface: "sessions", filter: @filter, q: @query, page: @page }, class: "btn btn--danger btn--sm", aria: { label: t("coplan.access.messages.revoke_name", name: token.name) }, data: { turbo_submits_with: t("coplan.access.messages.revoking_pending") } %>
    <% end %>
  </td>
</tr>
