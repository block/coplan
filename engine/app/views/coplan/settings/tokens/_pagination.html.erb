<% if @page > 1 || @has_next %>
  <% path_for = ->(page) { @sessions_view ? settings_agent_sessions_path(filter: @filter, q: @query, page: page) : settings_tokens_path(page: page) } %>
  <nav class="access-pagination" aria-label="<%= t("coplan.access.pagination") %>">
    <% if @page > 1 %><%= link_to t("coplan.access.messages.previous"), path_for.call(@page - 1), rel: "prev" %><% end %>
    <span class="access-muted"><%= t("coplan.access.page") %> <%= @page %></span>
    <% if @has_next %><%= link_to t("coplan.access.messages.next"), path_for.call(@page + 1), rel: "next" %><% end %>
  </nav>
<% end %>
