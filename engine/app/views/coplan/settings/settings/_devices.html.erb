<%# Per-device list rendered both in-page (initial load) and as a turbo-frame %>
<%# response after the Stimulus controller refreshes it post-enable/disable. %>
<%= turbo_frame_tag "web-push-devices" do %>
  <% if web_push_subscriptions.any? %>
    <div class="settings-subsection">
      <div class="settings-subsection__heading"><%= t("coplan.preferences.devices_receiving_notifications") %></div>
      <ul class="device-list">
        <% web_push_subscriptions.each do |sub| %>
          <li class="device-list__item">
            <div class="device-list__name"><%= sub.device_label %></div>
            <div class="device-list__meta">
              <%= t("coplan.display.device_added", when: relative_ui_time(sub.created_at)) %>
              <% if sub.last_delivered_at %>
                · <%= t("coplan.display.device_last_notified", when: relative_ui_time(sub.last_delivered_at)) %>
                · <%= t("coplan.display.notifications", count: sub.notifications_delivered_count) %>
              <% else %>
                <%= t("coplan.preferences.no_notifications_yet") %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
      <p class="settings-subsection__hint">
        <%= t("coplan.preferences.to_remove_a_device_sign") %>
      </p>
    </div>
  <% end %>
<% end %>
