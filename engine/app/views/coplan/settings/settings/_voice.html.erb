<%# Which key holds the microphone open. Push-to-talk was Shift and only
    Shift, which is a poor fit for anyone who types capitals near the mic
    and impossible for anyone whose browser or OS already spends the key.

    Presets rather than a free capture: each one behaves differently on
    purpose (a bare modifier has to be held past a delay to tell talking
    from typing; a chord starts recording on the press), and the mic's
    tooltip has to be able to name whichever one is in force. %>
<div class="card mb-md" data-controller="coplan--voice-hotkey"
     data-coplan--voice-hotkey-url-value="<%= coplan.settings_voice_hotkey_path %>">
  <div class="settings-row">
    <div class="settings-row__main">
      <span class="settings-row__label"><%= t("coplan.preferences.hold_to_talk") %></span>
      <p class="settings-row__hint">
        <%= t("coplan.preferences.hold_this_key_on_a") %>
        <span data-coplan--voice-hotkey-target="macNote"
              <%= "hidden" unless current_user.voice_hotkey == "ctrl_space" %>>
          <%= t("coplan.preferences.macos_uses_ctrl_space_to") %>
        </span>
      </p>
      <p class="settings-row__hint settings-row__hint--error" role="status"
         data-coplan--voice-hotkey-target="error" hidden></p>
    </div>
    <div class="segmented">
      <% Coplan::User::VOICE_HOTKEYS.each do |hotkey| %>
        <label class="segmented__option" title="<%= voice_hotkey_label(hotkey) %>">
          <input type="radio" name="voice_hotkey" value="<%= hotkey %>"
                 <%= "checked" if current_user.voice_hotkey == hotkey %>
                 data-action="coplan--voice-hotkey#select">
          <span class="segmented__btn"><%= voice_hotkey_label(hotkey) %></span>
        </label>
      <% end %>
    </div>
  </div>
</div>
