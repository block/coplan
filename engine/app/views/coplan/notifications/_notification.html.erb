<% if notification.review_notification? %>
  <%= render "coplan/reviews/notification", notification: notification %>
<% else %>
<%= content_tag :div, id: dom_id(notification), class: "card notifications-list__item #{'notifications-list__item--read' if notification.read?}" do %>
  <div class="notifications-list__header">
    <%= link_to notification.plan.title, notification_path(notification), class: "notifications-list__plan-title" %>
    <span class="badge badge--<%= notification.reason.dasherize %>"><%= notification_reason_label(notification.reason) %></span>
    <% unless notification.read? %>
      <%= button_to t("coplan.notifications.messages.mark_read"), mark_read_notification_path(notification), method: :patch, class: "btn btn--secondary btn--sm", form: { data: { turbo_stream: true } } %>
    <% end %>
  </div>
  <div class="notifications-list__body">
    <% thread = notification.comment_thread %>
    <% if thread.anchored? %>
      <span class="notifications-list__anchor">"<%= thread.anchor_preview(max_length: 60) %>"</span>
    <% end %>
    <% first_comment = thread.comments.first %>
    <% if first_comment %>
      <p class="notifications-list__comment text-sm"><%= truncate(first_comment.public_body_markdown, length: 120) %></p>
    <% end %>
  </div>
  <div class="notifications-list__meta text-sm text-muted">
    <%= relative_ui_time(notification.created_at) %>
    <%= t("coplan.interface.notification_by", name: thread.created_by_user&.name || t("coplan.common.messages.unknown")) %>
  </div>
<% end %>
<% end %>
