<%= turbo_frame_tag "inbox-panel" do %>
<div class="inbox-panel__header">
  <span class="inbox-panel__title"><%= t("coplan.notifications.inbox") %></span>
  <% if @unread_count > 0 %>
    <%= button_to t("coplan.notifications.messages.mark_all_read"), mark_all_read_notifications_path, method: :post, class: "btn btn--secondary btn--sm", form: { data: { turbo_stream: true } } %>
  <% end %>
</div>

<%= render "coplan/reviews/tasks", tasks: @review_tasks || [] %>

<% if @notifications.any? %>
  <div class="inbox-panel__list">
    <% @notifications.each do |notification| %>
      <% if notification.review_notification? %>
        <%= render "coplan/reviews/notification", notification: notification %>
      <% else %>
      <% thread = notification.comment_thread %>
      <% triggering_comment = notification.comment || thread.comments.first %>
      <%= link_to notification_path(notification), class: "inbox-row #{'inbox-row--unread' unless notification.read?}", data: { turbo: false } do %>
        <div class="inbox-row__indicator">
          <% unless notification.read? %>
            <span class="inbox-row__dot"></span>
          <% end %>
        </div>
        <div class="inbox-row__main">
          <div class="inbox-row__top">
            <span class="inbox-row__author">
              <% if triggering_comment %>
                <%= comment_author_name(triggering_comment) %>
              <% else %>
                <%= thread.created_by_user&.name || t("coplan.notifications.messages.someone") %>
              <% end %>
            </span>
            <span class="inbox-row__time"><%= time_ago_in_words(notification.created_at) %></span>
          </div>
          <div class="inbox-row__body">
            <% if triggering_comment %>
              <%= truncate(triggering_comment.public_body_markdown, length: 100) %>
            <% else %>
              <%= t("coplan.notifications.thread") %> <%= notification_reason_label(notification.reason).downcase %>
            <% end %>
          </div>
          <div class="inbox-row__footer">
            <span class="inbox-row__plan"><%= notification.plan.title %></span>
            <span class="badge badge--<%= thread.status %>"><%= thread.status == "resolved" ? t("coplan.interface.thread_resolved") : t("coplan.interface.thread_open") %></span>
            <% if triggering_comment&.agent? %>
              <span class="badge badge--agent"><%= t("coplan.common.agent") %></span>
            <% end %>
          </div>
        </div>
      <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="inbox-panel__empty">
    <%= t("coplan.notifications.no_unread_notifications") %>
  </div>
<% end %>
<% end %>
