<% creating = @plan.new_record? %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<% content_for(:title, "#{creating ? 'New document' : @plan.title} — CoPlan") %>
<%= form_with url: creating ? plans_path : update_content_plan_path(@plan), method: creating ? :post : :patch,
    class: "document-editor", data: { controller: "coplan--editor", turbo: false,
    action: "submit->coplan--editor#submit input->coplan--editor#input keydown->coplan--editor#keydown focusin->coplan--editor#focusPane compositionend->coplan--editor#compositionEnded beforeunload@window->coplan--editor#beforeUnload turbo:before-visit@document->coplan--editor#beforeVisit turbo:before-stream-render@document->coplan--editor#stream online@window->coplan--editor#reconnect focus@window->coplan--editor#refresh",
    "coplan--editor-plan-id-value": @plan.id || "new", "coplan--editor-user-id-value": current_user.id,
    "coplan--editor-revision-value": @base_revision,
    "coplan--editor-state-url-value": creating ? "" : editor_state_plan_path(@plan),
    "coplan--editor-lease-url-value": creating ? "" : editor_lease_plan_path(@plan),
    "coplan--editor-preview-url-value": preview_draft_plans_path } do %>
  <div data-coplan--editor-target="subscription" hidden><%= turbo_stream_from @plan unless creating %></div>
  <div class="document-editor__top">
    <div class="document-editor__identity">
      <%= text_field_tag "plan[title]", @plan.title, required: true, maxlength: 255, placeholder: "Untitled document", class: "document-editor__title", aria: { label: "Document title" } %>
      <div class="document-editor__byline">
        <span role="status" aria-live="polite" data-coplan--editor-target="status" data-state="loading">Opening document…</span>
        <details class="document-editor__menu">
          <summary title="Document details">Details <span aria-hidden="true">⌄</span></summary>
          <div class="document-editor__menu-panel">
            <p>Comments are available in reading view.</p>
            <label for="plan_tag_names">Tags</label>
            <%= text_field_tag "plan[tag_names]", @plan.tag_names.join(", "), placeholder: "Tags separated by commas" %>
            <label for="change_summary">Change summary</label>
            <%= text_field_tag :change_summary, nil, placeholder: "Optional", maxlength: 200 %>
          </div>
        </details>
      </div>
    </div>
    <div class="document-editor__actions">
      <div class="document-editor__mode" role="group" aria-label="Editing mode">
        <button type="button" aria-pressed="true" data-mode="rich" data-action="coplan--editor#switchMode">Editor</button>
        <button type="button" aria-pressed="false" data-mode="markdown" data-action="coplan--editor#switchMode">Raw</button>
        <button type="button" aria-pressed="false" data-mode="dual" data-action="coplan--editor#switchMode">Dual</button>
      </div>
      <%= link_to creating ? library_browse_path(current_user.library) : plan_browse_path(@plan), class: "document-editor__back", title: "Close editor", aria: { label: "Close editor" }, data: { turbo: true, turbo_prefetch: false, action: "click->coplan--editor#back", "coplan--editor-target": "back" } do %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg>
      <% end %>
    </div>
  </div>
  <% if @conflict %><p class="editor__conflict">This plan was updated to v<%= @conflict_revision %>. Your draft is preserved.</p><% end %>
  <div class="editor__draft-notice" data-coplan--editor-target="draftNotice" hidden>
    <span>Recovered an unsaved draft.</span>
    <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--editor#discardDraft">Discard recovered draft</button>
  </div>
  <div class="editor__conflict" data-coplan--editor-target="conflict" hidden>
    <p data-coplan--editor-target="error"></p>
    <div class="document-editor__recovery-actions">
      <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--editor#reconnect">Retry sync</button>
      <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--editor#download">Download my draft</button>
      <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--editor#useLatest">Use saved version</button>
      <button type="button" class="btn btn--danger btn--sm" data-coplan--editor-target="replace" data-action="coplan--editor#replace" hidden>Replace reviewed version with my draft</button>
    </div>
    <details><summary>Review the saved version</summary><pre data-coplan--editor-target="latest"></pre></details>
  </div>
  <div data-coplan--editor-target="toolbar" class="document-editor__toolbar" role="toolbar" aria-label="Text formatting" data-action="mousedown->coplan--editor#keepSelection">
    <select aria-label="Paragraph style" data-command="heading" data-coplan--editor-target="style" data-action="change->coplan--editor#style">
      <option value="0">Normal text</option><option value="1">Heading 1</option><option value="2">Heading 2</option><option value="3">Heading 3</option><option value="code">Code block</option>
    </select>
    <span class="document-editor__tool-divider" aria-hidden="true"></span>
    <div class="document-editor__insert-code">
      <button type="button" aria-label="Insert code block" title="Insert code block" popovertarget="coplan-insert-code"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="m8 9-3 3 3 3m8-6 3 3-3 3"/></svg></button>
      <div id="coplan-insert-code" class="document-editor__code-picker" popover data-coplan--editor-target="codePicker" data-action="beforetoggle->coplan--editor#prepareCodePicker toggle->coplan--editor#codePickerToggled resize@window->coplan--editor#positionCodePicker scroll@document->coplan--editor#positionCodePicker:capture">
        <input id="coplan-insert-language" aria-label="New code language" role="combobox" aria-autocomplete="list" aria-controls="coplan-code-options" aria-expanded="false" autocomplete="off" autofocus placeholder="Search languages…" data-coplan--editor-target="newLanguage" data-action="input->coplan--editor#filterCodeLanguages keydown->coplan--editor#codePickerKeydown">
        <div id="coplan-code-options" class="document-editor__code-options" role="listbox" aria-label="Code languages">
          <% language_labels = { "text" => "Plain text", "javascript" => "JavaScript", "typescript" => "TypeScript", "sql" => "SQL", "json" => "JSON", "yaml" => "YAML", "html" => "HTML", "css" => "CSS" } %>
          <% (["text"] + CoPlan.configuration.editor_code_languages).uniq.each_with_index do |language, index| %>
            <button type="button" role="option" tabindex="-1" id="coplan-code-option-<%= index %>" aria-selected="false" data-language="<%= language %>" data-coplan--editor-target="codeOption" data-action="coplan--editor#chooseCodeLanguage"><%= language_labels.fetch(language, language.capitalize) %></button>
          <% end %>
        </div>
        <button type="button" class="document-editor__code-insert" data-action="coplan--editor#insertCode">Insert</button>
      </div>
    </div>
    <% [["bold", "Bold", "⌘B / Ctrl+B", "B"], ["italic", "Italic", "⌘I / Ctrl+I", "I"], ["code", "Inline code", "", "</>"], ["link", "Link", "⌘K / Ctrl+K", ""]].each do |command, label, shortcut, icon| %>
      <button type="button" data-command="<%= command %>" aria-label="<%= label %>" aria-pressed="false" title="<%= [label, shortcut.presence].compact.join(' · ') %>" data-action="coplan--editor#format"><% if command == "link" %><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><% else %><span aria-hidden="true" class="format-icon format-icon--<%= command %>"><%= icon %></span><% end %></button>
    <% end %>
    <span class="document-editor__tool-divider" aria-hidden="true"></span>
    <% [["bullet", "Bullet list", "⌘⇧8 / Ctrl+Shift+8", "•", "M8 6h12M8 12h12M8 18h12"], ["ordered", "Numbered list", "⌘⇧7 / Ctrl+Shift+7", "1", "M8 6h12M8 12h12M8 18h12"], ["quote", "Block quote", "", "❞", ""]].each do |command, label, shortcut, icon, path| %>
      <button type="button" data-command="<%= command %>" aria-label="<%= label %>" aria-pressed="false" title="<%= [label, shortcut.presence].compact.join(' · ') %>" data-action="coplan--editor#format">
        <% if path.present? %><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><text x="0" y="9" fill="currentColor" font-size="10"><%= icon %></text><path d="<%= path %>" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><% else %><span class="format-icon" aria-hidden="true"><%= icon %></span><% end %>
      </button>
    <% end %>
    <span class="document-editor__tool-divider" aria-hidden="true"></span>
    <% [["undo", "Undo", "⌘Z / Ctrl+Z", "↶"], ["redo", "Redo", "⌘⇧Z / Ctrl+Shift+Z", "↷"]].each do |command, label, shortcut, icon| %>
      <button type="button" data-command="<%= command %>" aria-label="<%= label %>" title="<%= label %> · <%= shortcut %>" data-action="coplan--editor#format"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"<% if command == "redo" %> style="transform: scaleX(-1)"<% end %>><path d="M8 3 3 8l5 5M3 8h11a6 6 0 0 1 0 12h-2"/></svg></button>
    <% end %>
  </div>
  <datalist id="coplan-code-languages"><% CoPlan.configuration.editor_code_languages.each do |language| %><option value="<%= language %>"><% end %></datalist>
  <div class="document-editor__paper plan-document card">
    <div class="document-editor__raw" data-coplan--editor-target="rawSurface" hidden></div>
    <div class="document-editor__body" data-coplan--editor-target="surface"></div>
    <%= text_area_tag :content, @draft_content, hidden: true, data: { "coplan--editor-target": "textarea" } %>
    <%= hidden_field_tag :base_revision, @base_revision %>
  </div>
<% end %>
