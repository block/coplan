<% general_threads = threads.reject(&:anchored?).reject(&:out_of_date?) %>
<aside id="plan-general-comments" class="detached-comments general-comments<%= ' detached-comments--all-resolved' if general_threads.any? && general_threads.all?(&:closed?) %>" aria-label="Document comments"<%= " hidden" if general_threads.empty? %>>
  <% if general_threads.any? %>
    <details class="document-support__disclosure" data-controller="coplan--support-disclosure" data-action="toggle->coplan--support-disclosure#remember" open><summary class="document-support__heading"><span class="document-support__chevron" aria-hidden="true">›</span><h2 class="plan-footnote__title">Comments</h2><span class="document-support__count"><%= general_threads.size %></span></summary>
    <div class="document-support__content">
    <% reviews = CoPlan::ReviewResponse.where(comment_thread_id: general_threads.map(&:id)).includes(:plan_version).index_by(&:comment_thread_id) %>
    <% general_threads.each do |thread| %>
      <%= render "coplan/plans/document_comment", thread: thread, review: reviews[thread.id], detached: false %>
    <% end %>
    </div></details>
  <% end %>
</aside>
