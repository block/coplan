<aside id="plan-general-comments" class="detached-comments general-comments" aria-label="<%= t("coplan.documents.document_comments") %>" data-controller="coplan--document-comments" data-action="coplan:anchors-updated@document->coplan--document-comments#anchorsUpdated coplan:show-document-thread->coplan--document-comments#revealThread coplan:document-comments-changed->coplan--document-comments#applyFilter coplan:plan-comment-posted->coplan--document-comments#posted">
  <details data-coplan--document-comments-target="disclosure" class="document-support__disclosure" data-controller="coplan--support-disclosure" data-action="toggle->coplan--support-disclosure#remember">
    <summary class="document-support__heading"><span class="document-support__chevron" aria-hidden="true">›</span><h2 class="plan-footnote__title"><%= t("coplan.documents.comments") %></h2><span class="document-support__count" data-coplan--document-comments-target="count"></span></summary>
    <div class="document-support__content">
      <div class="document-comments__filters"><label for="document-comment-filter"><%= t("coplan.documents.show") %></label><select id="document-comment-filter" data-coplan--document-comments-target="filter" data-action="coplan--document-comments#filterChanged"><option value="open"><%= t("coplan.documents.open") %></option><option value="resolved"><%= t("coplan.documents.resolved") %></option><option value="all"><%= t("coplan.documents.all_comments") %></option></select></div>
      <%= render "coplan/plans/general_comment_list", threads: threads %>
      <p class="document-comments__empty text-sm text-muted" data-coplan--document-comments-target="empty" hidden></p>
    </div>
  </details>
  <% if current_user %><button type="button" class="section-add document-support__add" aria-label="<%= t("coplan.documents.add_comment") %>" title="<%= t("coplan.documents.add_comment") %>" data-action="coplan--text-selection#openPlanComment">+</button><% end %>
</aside>
