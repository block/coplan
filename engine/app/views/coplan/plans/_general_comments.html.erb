<aside id="plan-general-comments" class="detached-comments general-comments" aria-label="Document comments" data-controller="coplan--document-comments" data-action="coplan:show-document-thread->coplan--document-comments#revealThread coplan:document-comments-changed->coplan--document-comments#applyFilter coplan:plan-comment-posted->coplan--document-comments#posted">
  <details class="document-support__disclosure" data-controller="coplan--support-disclosure" data-action="toggle->coplan--support-disclosure#remember">
    <summary class="document-support__heading"><span class="document-support__chevron" aria-hidden="true">›</span><h2 class="plan-footnote__title">Comments</h2><span class="document-support__count" data-coplan--document-comments-target="count"></span></summary>
    <div class="document-support__content">
      <div class="document-comments__filters"><label for="document-comment-filter">Show</label><select id="document-comment-filter" data-coplan--document-comments-target="filter" data-action="coplan--document-comments#filterChanged"><option value="open">Open</option><option value="resolved">Resolved</option><option value="all">All comments</option></select></div>
      <%= render "coplan/plans/general_comment_list", threads: threads %>
      <p class="document-comments__empty text-sm text-muted" data-coplan--document-comments-target="empty" hidden></p>
    </div>
  </details>
  <% if current_user %><button type="button" class="section-add document-support__add" aria-label="Add comment" title="Add comment" data-action="coplan--text-selection#openPlanComment">+</button><% end %>
</aside>
