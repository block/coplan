<% selected = @first_version && @version && version.revision.between?(@first_version.revision, @version.revision) %>
<% line_changes = version.history_line_changes(previous_version: previous_version) %>
<div class="history-split__item<%= ' history-split__item--active' if selected %>"
     data-coplan--history-target="item" data-revision="<%= version.revision %>">
  <%= link_to plan_version_browse_path(plan, version),
        class: "history-split__entry",
        aria: { current: ("true" if version.revision == @version&.revision) },
        data: { action: "coplan--history#select", revision: version.revision, diff_url: plan_version_diff_browse_path(plan, version) } do %>
    <div class="history-split__entry-heading">
      <span class="history-split__version">v<%= version.revision %></span>
      <% if line_changes %>
        <% added, removed = line_changes %>
        <% description = "#{pluralize(added, 'line')} added, #{pluralize(removed, 'line')} removed" %>
        <span class="history-split__stats" title="<%= description %>">
          <span class="visually-hidden"><%= description %></span>
          <span class="history-split__added" aria-hidden="true">+<%= number_with_delimiter(added) %></span>
          <span class="history-split__removed" aria-hidden="true">−<%= number_with_delimiter(removed) %></span>
        </span>
      <% end %>
    </div>
    <div class="history-split__meta">
      <% if version.actor_user %>
        <%= user_avatar(version.actor_user) %> <span><%= history_actor_name(version) %></span>
      <% else %>
        <span class="badge badge--type"><%= version.agent_name.presence || version.actor_type %></span>
      <% end %>
    </div>
    <% if version.change_summary.present? %>
      <div class="history-split__summary"><%= version.change_summary %></div>
    <% end %>
    <div class="history-split__time"><%= time_ago_in_words(version.created_at) %> ago</div>
  <% end %>
</div>
