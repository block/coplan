<% content_for(:title, "#{@plan.title} — CoPlan") %>
<% content_for(:head) do %>
  <%# One address per document. Anything that reaches this page by the
      legacy /plans/<uuid> form — a link that predates slugs — still says
      here which URL is the real one. %>
  <link rel="canonical" href="<%= plan_browse_url(@plan) %>">
  <meta property="og:title" content="<%= @plan.title %>">
  <meta property="og:description" content="<%= plan_og_description(@plan) %>">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="CoPlan">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= @plan.title %>">
  <meta name="twitter:description" content="<%= plan_og_description(@plan) %>">
<% end %>

<% reference_count = plan_reference_count(@plan, @references) %>

<%# Fills the sticky nav's title slot (see layouts/coplan/application). The
    containing-folder control, icon, and title mirror the masthead;
    coplan--nav-title fades them in once #plan-header scrolls behind the bar. %>
<% content_for :nav_title do %>
  <%= render "coplan/plans/nav_context", plan: @plan, placement: @placement %>
<% end %>

<%= turbo_stream_from @plan %>

<%# plan-keys: Backspace goes back to wherever you came from; [ / ] jump
    between the document and its footnote sections. Cold opens (direct link,
    new tab) have no history — fall back to the folder the plan actually
    lives in, not the workspace root. %>
<div data-controller="coplan--plan-keys coplan--folder-picker coplan--inline-editor"
     data-action="coplan:edit-request@document->coplan--inline-editor#open coplan:editor-ready->coplan--inline-editor#ready coplan:editor-closed->coplan--inline-editor#closed coplan:editor-error->coplan--inline-editor#error coplan:editor-saved->coplan--inline-editor#refreshThreads"
     data-coplan--inline-editor-content-url-value="<%= content_body_plan_path(@plan) %>"
     data-coplan--inline-editor-comments-url-value="<%= comments_body_plan_path(@plan) %>"
     data-coplan--plan-keys-fallback-url-value="<%= @placement ? folder_browse_path(@placement.folder) : library_browse_path(@plan.library) %>">

<%# The masthead: the plan's identity (broadcast-replaced #plan-header)
    on the left, and the viewer-relative side column (presence + toolbar)
    bottom-aligned on the right. Two DOM subtrees, one visual block —
    broadcasts own the left, this request (and the visibility/archive
    stream responses) own the right, so neither can clobber the other. %>
<div class="plan-masthead" data-controller="coplan--presence" data-coplan--presence-plan-id-value="<%= @plan.id %>" data-plan-section="top">
  <%= render partial: "coplan/plans/header", locals: { plan: @plan, placement: @placement } %>
  <div class="plan-masthead__side">
    <%= render partial: "coplan/plans/agent_sessions", locals: { agent_sessions: CoPlan::AgentSession.visible.where(plan_id: @plan.id).order(:created_at) } %>
    <%= render partial: "coplan/plans/viewers", locals: { viewers: CoPlan::PlanViewer.active_viewers_for(@plan), current_user: current_user } %>
    <%= render partial: "coplan/plans/toolbar", locals: { plan: @plan, placement: @placement } %>
  </div>
</div>

<%= render partial: "coplan/plans/banner", locals: { plan: @plan } %>

<div class="plan-document card">
  <% if @plan.current_content.present? %>
    <div class="plan-layout plan-layout--hide-resolved" data-controller="coplan--source-comments coplan--text-selection coplan--content-nav coplan--checkbox coplan--changed-sections coplan--reference-preview" data-coplan--text-selection-focus-thread-value="<%= params[:thread] %>" data-action="coplan:source-thread->coplan--source-comments#openThread coplan:resolved-visibility->coplan--source-comments#resolvedVisibilityChanged coplan:diagram-moved->coplan--source-comments#positionPanel keydown.esc@document->coplan--source-comments#dismiss:capture turbo:before-cache@document->coplan--source-comments#beforeCache coplan:mermaid-settled->coplan--source-comments#refresh coplan:content-updated->coplan--source-comments#refresh coplan:expander-opened->coplan--source-comments#refresh coplan:expander-closing->coplan--source-comments#expanderClosing keydown@document->coplan--text-selection#selectionKey keydown.esc@document->coplan--text-selection#dismiss keydown.esc@document->coplan--reference-preview#dismiss click@document->coplan--reference-preview#dismissFromOutside scroll@window->coplan--reference-preview#reposition resize@window->coplan--reference-preview#reposition coplan:open-thread@document->coplan--text-selection#openThread coplan:content-updated->coplan--content-nav#contentUpdated coplan:remote-change->coplan--content-nav#remoteChange coplan:editor-content-changed->coplan--content-nav#editorContentChanged coplan:editor-preview-settled->coplan--text-selection#editorPreviewSettled coplan:mermaid-settled->coplan--text-selection#editorPreviewSettled" data-coplan--checkbox-revision-value="<%= @plan.current_revision %>" data-coplan--checkbox-toggle-url-value="<%= toggle_checkbox_plan_path(@plan) %>" data-coplan--changed-sections-keys-value="<%= @changed_sections.keys.to_json %>" data-coplan--changed-sections-rewritten-value="<%= @changed_sections.rewritten? %>" data-coplan--changed-sections-history-url-value="<%= plan_history_browse_path(@plan) %>">
      <nav class="content-nav" data-coplan--content-nav-target="sidebar" aria-label="Document outline">
        <%# No "Contents" label — the outline speaks for itself, and the plan
            title now lives in the sticky nav. Just the collapse control. %>
        <div class="content-nav__header">
          <button type="button" class="content-nav__toggle" data-action="coplan--content-nav#toggle" data-coplan--content-nav-target="toggleBtn" aria-label="Hide table of contents" title="Toggle (t)">✕</button>
        </div>
        <ul class="content-nav__list" data-coplan--content-nav-target="list"></ul>
        <%# The document's back matter, one hop below the outline — slightly
            set apart so it reads as "after the document", not part of it. %>
        <ul class="content-nav__list content-nav__list--footnotes">
          <%# ids: the reference/attachment Turbo Streams keep these counts
              live alongside the footnote headers' own counters.

              The jump is handled in JS for the same reason the outline links
              above are: Turbo treats a same-page fragment link as a full
              visit, so the bare anchor refetched and re-rendered the page —
              and on a deck the re-rendered slides settle their heights
              asynchronously, landing the scroll nowhere near the section. %>
          <li><a href="#footnote-references" class="content-nav__footnote-link" data-action="coplan--content-nav#jumpToSection">References <span class="section-count" id="nav-references-count"><%= reference_count %></span></a></li>
          <li><a href="#footnote-attachments" class="content-nav__footnote-link" data-action="coplan--content-nav#jumpToSection">Attachments <span class="section-count" id="nav-attachments-count"><%= @attachments.size %></span></a></li>
        </ul>
      </nav>
      <button type="button" class="content-nav-show-btn" data-action="coplan--content-nav#toggle" data-coplan--content-nav-target="showBtn" title="Show table of contents (t)">☰ <kbd>t</kbd></button>

      <%# Mermaid swaps its source block for rendered SVG asynchronously —
          re-run anchor highlighting once each diagram settles so comments
          anchored to diagram labels get their marks (and pending ?thread=
          deep links can resolve). %>
      <div class="plan-layout__content">
        <%# Presentations present: `p` or the button fills the window with
            the deck (deck_presenter_controller) — a window is what a call
            can screen-share, and `f` takes the whole screen for a room.
            The wrapper sits outside the live-update swap target so a
            collaborator's edit landing mid-show doesn't disconnect the
            presenter — and the toolbar sits outside the text-selection
            content target below, because its
            label is visible text and comment anchors count visible-text
            occurrences under that target. %>
        <%# Selection-to-comment is scoped to this inner wrapper: the back
            matter below shares the column but must not offer comment
            anchors — they'd never resolve against the document body. %>
        <div data-coplan--text-selection-target="content" data-coplan--content-nav-target="content" data-coplan--inline-editor-target="reader" data-action="coplan:mermaid-settled->coplan--text-selection#handleContentSettled coplan:highlight-settled->coplan--text-selection#handleContentSettled">
          <div id="plan-content-body"
               data-controller="coplan--live-update"
               data-coplan--live-update-revision-value="<%= @plan.current_revision %>">
            <%= render partial: "coplan/plans/content_body", locals: { plan: @plan } %>
          </div>


        </div>
        <% if allowed_to?(@plan, :edit_content?) %>
          <div class="inline-editor" data-coplan--inline-editor-target="editor" hidden>
            <template data-coplan--inline-editor-target="template"><%= render "coplan/plans/editor_form", inline_editor: true %></template>
          </div>
          <p class="inline-editor__error" data-coplan--inline-editor-target="error" role="alert" hidden></p>
        <% end %>
        <div class="comment-popover" data-coplan--text-selection-target="popover" style="display: none;">
          <button type="button" class="comment-popover__action" data-action="coplan--text-selection#openCommentForm" title="Comment on selected text (C)">
            <%# Lucide message-circle-plus, copyright 2026 Lucide Icons, ISC license. %>
            <svg class="comment-popover__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>
              <path d="M8 12h8M12 8v8"/>
            </svg>
            Comment <kbd>C</kbd>
          </button>
        </div>
        <%= render partial: "coplan/comment_threads/new_comment_form", locals: { plan: @plan } %>

        <%= render partial: "coplan/plans/footnotes",
              locals: { plan: @plan, references: @references, attachments: @attachments } %>

        <%# Footnote citations and explicit same-document section links share
            one native popover. Its body is filled instantly from the rendered
            target already on the page. Hover/focus previews it; clicking the
            original anchor jumps directly to the referenced target. %>
        <aside id="reference-preview"
               class="reference-preview"
               popover="manual"
               role="dialog"
               data-coplan--reference-preview-target="popover"
               data-action="mouseenter->coplan--reference-preview#popoverEnter mouseleave->coplan--reference-preview#popoverLeave">
          <button type="button" class="reference-preview__close" aria-label="Close reference preview" data-action="coplan--reference-preview#dismiss">×</button>
          <strong id="reference-preview-title" class="reference-preview__title" data-coplan--reference-preview-target="title"></strong>
          <div class="reference-preview__body" data-coplan--reference-preview-target="body"></div>
        </aside>
        <%= render partial: "coplan/comment_threads/source_comments", locals: { plan: @plan } %>
      </div>

      <%= render "coplan/plans/thread_collection", plan: @plan, threads: @threads %>
    </div>
  <% else %>
    <div class="empty-state">
      <p>This plan has no content yet.</p>
    </div>
    <%# No content, no layout columns — back matter still belongs on the page. %>
    <%= render partial: "coplan/plans/footnotes",
          locals: { plan: @plan, references: @references, attachments: @attachments } %>
  <% end %>
</div>

<%= render partial: "coplan/shared/folder_picker", locals: { folders: @my_folders } %>

<% if current_user && @plan.current_content.present? %>
  <%= render partial: "coplan/plans/voice_control", locals: { plan: @plan } %>
<% end %>

<%# Headless comment navigation — no floating toolbar, just the keyboard:
    j/k step through comments, r focuses reply, e resolves,
    s toggles resolved-thread visibility. Rendered even when the page
    loads without a single thread: comments arrive live (voice, selection,
    other viewers' broadcasts), and gating this on @threads.any? left the
    first comment on a fresh plan with no keyboard at all. %>
<div data-controller="coplan--comment-nav"
     data-action="coplan:anchors-updated@document->coplan--comment-nav#handleAnchorsUpdated coplan:comment-navigate@document->coplan--comment-nav#navigateExpanded"
     hidden></div>

</div>
