<% creating = @plan.new_record? %>
<% inline_editor = local_assigns.fetch(:inline_editor, false) %>
<%= form_with url: creating ? plans_path : update_content_plan_path(@plan), method: creating ? :post : :patch,
    class: "document-editor", id: (inline_editor ? "coplan-inline-editor-form" : nil), data: { controller: "coplan--editor", turbo: false, "coplan--editor-inline-value": inline_editor,
    action: "submit->coplan--editor#submit input->coplan--editor#input keydown->coplan--editor#keydown focusin->coplan--editor#focusPane compositionend->coplan--editor#compositionEnded coplan:template-note-rejected->coplan--editor#templateNoteRejected beforeunload@window->coplan--editor#beforeUnload turbo:before-visit@document->coplan--editor#beforeVisit turbo:before-stream-render@document->coplan--editor#stream online@window->coplan--editor#reconnect focus@window->coplan--editor#refresh",
    "coplan--editor-plan-id-value": @plan.id || "new", "coplan--editor-user-id-value": current_user.id,
    "coplan--editor-draft-scope-value": (creating ? "#{@new_plan_type&.id || 'general'}-#{@new_folder&.id || 'root'}" : ""),
    "coplan--editor-revision-value": @base_revision,
    "coplan--editor-state-url-value": creating ? "" : editor_state_plan_path(@plan),
    "coplan--editor-token-url-value": creating ? new_plan_path : "",
    "coplan--editor-lease-url-value": creating ? "" : editor_lease_plan_path(@plan),
    "coplan--editor-attachments-url-value": creating ? "" : plan_attachments_path(@plan),
    "coplan--editor-embed-domains-value": Coplan::EmbedDomain.order(:hostname).pluck(:hostname).to_json,
    "coplan--editor-preview-url-value": preview_draft_plans_path } do %>
  <% if creating %>
    <%= hidden_field_tag :plan_type_id, @new_plan_type&.id %>
    <%= hidden_field_tag :folder_id, @new_folder&.id %>
  <% end %>
  <div data-coplan--editor-target="subscription" hidden><%= coplan_plan_streams @plan unless creating %></div>
  <% if inline_editor %>
    <%= hidden_field_tag "plan[tag_names]", @plan.tag_names.join(", "), id: "inline-plan-tags" %>
    <%= link_to creating ? (@new_folder ? folder_browse_path(@new_folder) : library_browse_path(current_user.library)) : plan_browse_path(@plan), hidden: true, data: { "coplan--editor-target": "back" } do %><%= t("coplan.editor.close_editor") %><% end %>
  <% else %>
  <div class="document-editor__top">
    <div class="document-editor__identity">
      <%= hidden_field_tag "plan[tag_names]", @plan.tag_names.join(", ") %>
    </div>
    <div class="document-editor__actions">
      <div class="document-editor__mode" role="group" aria-label="<%= t("coplan.editor.editing_mode") %>">
        <button type="button" aria-pressed="true" data-mode="rich" data-action="coplan--editor#switchMode"><%= t("coplan.editor.editor") %></button>
        <button type="button" aria-pressed="false" data-mode="markdown" data-action="coplan--editor#switchMode"><%= t("coplan.editor.raw") %></button>
        <button type="button" aria-pressed="false" data-mode="dual" data-action="coplan--editor#switchMode"><%= t("coplan.editor.dual") %></button>
      </div>
      <%= link_to creating ? (@new_folder ? folder_browse_path(@new_folder) : library_browse_path(current_user.library)) : plan_browse_path(@plan), class: "document-editor__back", title: t("coplan.editor.close_editor"), aria: { label: t("coplan.editor.close_editor") }, data: { turbo: true, turbo_prefetch: false, action: "click->coplan--editor#back", "coplan--editor-target": "back" } do %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg>
      <% end %>
    </div>
  </div>
  <% end %>
  <% if @conflict && !inline_editor %><p class="editor__conflict"><%= t("coplan.interface.draft_preserved", revision: @conflict_revision) %></p><% end %>
  <div class="editor__draft-notice" data-coplan--editor-target="legacyDraftNotice" hidden>
    <span><%= t("coplan.editor.an_older_draft_is_available") %></span>
    <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--editor#reviewLegacyDraft"><%= t("coplan.editor.review_older_draft") %></button>
  </div>
  <div class="editor__draft-notice" data-coplan--editor-target="draftNotice" hidden>
    <span><%= t("coplan.editor.recovered_an_unsaved_draft") %></span>
    <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--editor#discardDraft"><%= t("coplan.editor.discard_recovered_draft") %></button>
  </div>
  <div class="editor__conflict" data-coplan--editor-target="conflict" hidden>
    <p data-coplan--editor-target="error"></p>
    <div class="document-editor__recovery-actions">
      <button type="button" class="btn btn--primary btn--sm" data-coplan--editor-target="retry" data-action="coplan--editor#reconnect"><%= t("coplan.editor.retry_sync") %></button>
      <% unless inline_editor %>
        <button type="button" class="btn btn--secondary btn--sm" data-action="coplan--editor#discardChanges"><%= t("coplan.editor.discard_my_unsaved_changes") %></button>
      <% end %>
      <button type="button" class="btn btn--danger btn--sm" data-coplan--editor-target="replace" data-action="coplan--editor#replace" hidden><%= t("coplan.editor.replace_reviewed_version_with_my") %></button>
    </div>
    <details data-coplan--editor-target="review"><summary><%= t("coplan.editor.review_the_saved_version") %></summary><pre data-coplan--editor-target="latest"></pre></details>
  </div>
  <div data-coplan--editor-target="toolbar" class="document-editor__toolbar" role="toolbar" aria-label="<%= t("coplan.editor.text_formatting") %>" data-action="mousedown->coplan--editor#keepSelection">
    <% if inline_editor %>
      <button type="button" class="document-editor__outline-toggle" aria-label="<%= t("coplan.editor.toggle_table_of_contents") %>" aria-expanded="false" title="<%= t("coplan.editor.toggle_table_of_contents_t") %>" data-coplan--content-nav-target="editorToggleBtn" data-action="coplan--content-nav#toggle" disabled>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg>
      </button>
    <% end %>
    <div class="document-editor__format-controls" data-coplan--editor-target="formatControls" data-action="scroll->coplan--editor#updateToolOverflow">
      <select aria-label="<%= t("coplan.editor.paragraph_style") %>" data-command="heading" data-coplan--editor-target="style" data-action="change->coplan--editor#style">
        <option value="0"><%= t("coplan.editor.normal_text") %></option><option value="1"><%= t("coplan.editor.heading_1") %></option><option value="2"><%= t("coplan.editor.heading_2") %></option><option value="3"><%= t("coplan.editor.heading_3") %></option><option value="comment"><%= t("coplan.common.comment") %></option><option value="code"><%= t("coplan.editor.code_block") %></option>
      </select>
      <span class="document-editor__tool-divider" aria-hidden="true"></span>
      <div class="document-editor__insert-code">
        <button type="button" aria-label="<%= t("coplan.editor.insert_code_block") %>" title="<%= t("coplan.editor.insert_code_block") %>" popovertarget="coplan-insert-code"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="m8 9-3 3 3 3m8-6 3 3-3 3"/></svg></button>
        <div id="coplan-insert-code" class="document-editor__code-picker" popover data-coplan--editor-target="codePicker" data-action="beforetoggle->coplan--editor#prepareCodePicker toggle->coplan--editor#codePickerToggled resize@window->coplan--editor#positionCodePicker scroll@document->coplan--editor#positionCodePicker:capture">
          <input id="coplan-insert-language" aria-label="<%= t("coplan.editor.new_code_language") %>" role="combobox" aria-autocomplete="list" aria-controls="coplan-code-options" aria-expanded="false" autocomplete="off" autofocus placeholder="<%= t("coplan.editor.search_languages_pending") %>" data-coplan--editor-target="newLanguage" data-action="input->coplan--editor#filterCodeLanguages keydown->coplan--editor#codePickerKeydown">
          <div id="coplan-code-options" class="document-editor__code-options" role="listbox" aria-label="<%= t("coplan.editor.code_languages") %>">
            <% language_labels = { "text" => t("coplan.editor.messages.plain_text"), "javascript" => "JavaScript", "typescript" => "TypeScript", "sql" => "SQL", "json" => "JSON", "yaml" => "YAML", "html" => "HTML", "css" => "CSS" } %>
            <% (["text"] + Coplan.configuration.editor_code_languages).uniq.each_with_index do |language, index| %>
              <button type="button" role="option" tabindex="-1" id="coplan-code-option-<%= index %>" aria-selected="false" data-language="<%= language %>" data-coplan--editor-target="codeOption" data-action="coplan--editor#chooseCodeLanguage"><%= language_labels.fetch(language, language.capitalize) %></button>
            <% end %>
          </div>
          <button type="button" class="document-editor__code-insert" data-action="coplan--editor#insertCode"><%= t("coplan.editor.insert") %></button>
        </div>
      </div>
      <div class="document-editor__insert-code">
        <button type="button" aria-label="<%= t("coplan.editor.insert_content") %>" aria-expanded="false" title="<%= t("coplan.editor.insert_content") %>" popovertarget="coplan-insert-content"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
        <div id="coplan-insert-content" class="document-editor__code-picker document-editor__content-picker" popover aria-label="<%= t("coplan.editor.insert_content") %>" data-coplan--editor-target="contentPicker" data-action="beforetoggle->coplan--editor#prepareContentPicker toggle->coplan--editor#contentPickerToggled resize@window->coplan--editor#positionContentPicker scroll@document->coplan--editor#positionContentPicker:capture">
          <button type="button" autofocus data-action="coplan--editor#insertPresentation"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 3h18v13H3z M12 16v5 M8 21h8 M7 7h10 M7 11h6"/></svg><%= t("coplan.editor.presentation") %></button>
          <button type="button" data-action="coplan--editor#insertEmbed"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m9 9-3 3 3 3m6-6 3 3-3 3"/></svg><%= t("coplan.editor.embed") %></button>
        </div>
      </div>
      <% [["bold", t("coplan.editor.messages.bold"), "⌘B / Ctrl+B", "B"], ["italic", t("coplan.editor.messages.italic"), "⌘I / Ctrl+I", "I"], ["code", t("coplan.editor.messages.inline_code"), "", "</>"], ["link", t("coplan.editor.messages.link"), "⌘K / Ctrl+K", ""]].each do |command, label, shortcut, icon| %>
        <button type="button" data-command="<%= command %>" aria-label="<%= label %>" aria-pressed="false" title="<%= [label, shortcut.presence].compact.join(' · ') %>" data-action="coplan--editor#format"><% if command == "link" %><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><% else %><span aria-hidden="true" class="format-icon format-icon--<%= command %>"><%= icon %></span><% end %></button>
      <% end %>
      <span class="document-editor__tool-divider" aria-hidden="true"></span>
      <% [["bullet", t("coplan.editor.messages.bullet_list"), "⌘⇧8 / Ctrl+Shift+8", "•", "M8 6h12M8 12h12M8 18h12"], ["ordered", t("coplan.editor.messages.numbered_list"), "⌘⇧7 / Ctrl+Shift+7", "1", "M8 6h12M8 12h12M8 18h12"], ["quote", t("coplan.editor.messages.block_quote"), "", "❞", ""]].each do |command, label, shortcut, icon, path| %>
        <button type="button" data-command="<%= command %>" aria-label="<%= label %>" aria-pressed="false" title="<%= [label, shortcut.presence].compact.join(' · ') %>" data-action="coplan--editor#format">
          <% if path.present? %><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><text x="0" y="9" fill="currentColor" font-size="10"><%= icon %></text><path d="<%= path %>" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><% else %><span class="format-icon" aria-hidden="true"><%= icon %></span><% end %>
        </button>
      <% end %>
      <span class="document-editor__tool-divider" aria-hidden="true"></span>
      <% [["undo", t("coplan.editor.messages.undo"), "⌘Z / Ctrl+Z", "↶"], ["redo", t("coplan.editor.messages.redo"), "⌘⇧Z / Ctrl+Shift+Z", "↷"]].each do |command, label, shortcut, icon| %>
        <button type="button" data-command="<%= command %>" aria-label="<%= label %>" title="<%= label %> · <%= shortcut %>" data-action="coplan--editor#format"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"<% if command == "redo" %> style="transform: scaleX(-1)"<% end %>><path d="M8 3 3 8l5 5M3 8h11a6 6 0 0 1 0 12h-2"/></svg></button>
      <% end %>
    </div>
    <% if inline_editor %>
      <button type="button" class="document-editor__more-tools" aria-label="<%= t("coplan.editor.more_formatting_tools") %>" title="<%= t("coplan.editor.more_formatting_tools") %>" data-coplan--editor-target="moreTools" data-action="coplan--editor#scrollTools" hidden>›</button>
      <div class="document-editor__mode document-editor__inline-mode" role="group" aria-label="<%= t("coplan.editor.editing_mode") %>">
        <button type="button" aria-pressed="true" data-mode="rich" data-action="coplan--editor#switchMode"><%= t("coplan.editor.editor") %></button>
        <button type="button" aria-pressed="false" data-mode="markdown" data-action="coplan--editor#switchMode"><%= t("coplan.editor.raw") %></button>
        <button type="button" aria-pressed="false" data-mode="dual" data-action="coplan--editor#switchMode"><%= t("coplan.editor.dual") %></button>
      </div>
      <button type="button" class="document-editor__close-inline" data-state="loading" aria-label="<%= t("coplan.editor.opening_document") %>" aria-describedby="coplan-inline-save-announcement" title="<%= t("coplan.editor.opening_document_pending") %>" data-action="coplan--editor#back" disabled>
        <svg class="document-editor__close-icon" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 12 5 5 10-10"/></svg>
    <% end %>
    <span class="document-editor__save-status" <% if inline_editor %>aria-hidden="true"<% else %>role="status" aria-live="polite" aria-atomic="true"<% end %> data-coplan--editor-target="status" data-state="loading" title="<%= t("coplan.editor.opening_document_pending") %>">
      <svg class="document-editor__save-queued" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <svg class="document-editor__save-spinner" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8" opacity=".2"/><path d="M12 4a8 8 0 0 1 8 8"/></svg>
      <svg class="document-editor__save-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><path d="m7.5 12 3 3 6-6"/></svg>
      <svg class="document-editor__save-error" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4h.01"/></svg>
      <svg class="document-editor__save-conflict" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6m0-6-6 6"/></svg>
      <span class="document-editor__save-text" data-coplan--editor-target="statusText"><%= t("coplan.editor.opening_document_pending") %></span>
    </span>
    <% if inline_editor %>
      </button>
      <span id="coplan-inline-save-announcement" class="document-editor__save-text" role="status" aria-live="polite" aria-atomic="true" data-coplan--editor-target="statusAnnouncement"><%= t("coplan.editor.opening_document_pending") %></span>
    <% end %>
  </div>
  <dialog class="document-editor__citation-dialog" data-coplan--editor-target="citationDialog" aria-labelledby="coplan-citation-title">
    <div class="document-editor__citation-heading">
      <h2 id="coplan-citation-title" data-coplan--editor-target="citationTitle"><%= t("coplan.editor.citation") %></h2>
      <button type="button" aria-label="<%= t("coplan.editor.close_citation_editor") %>" data-action="coplan--editor#closeCitation">×</button>
    </div>
    <label for="coplan-citation-body"><%= t("coplan.editor.citation_text_and_source_links") %></label>
    <textarea id="coplan-citation-body" rows="8" data-coplan--editor-target="citationBody" data-action="input->coplan--editor#citationInput"></textarea>
    <p class="document-editor__citation-error" role="alert" data-coplan--editor-target="citationError"></p>
    <div class="document-editor__citation-actions">
      <button type="button" class="btn btn--secondary" data-action="coplan--editor#closeCitation"><%= t("coplan.common.cancel") %></button>
      <button type="button" class="btn btn--primary" data-coplan--editor-target="citationSave" data-action="coplan--editor#saveCitation"><%= t("coplan.editor.save_citation") %></button>
    </div>
  </dialog>
  <datalist id="coplan-code-languages"><% Coplan.configuration.editor_code_languages.each do |language| %><option value="<%= language %>"><% end %></datalist>
  <div class="document-editor__upload-notice" data-coplan--editor-target="uploadNotice" popover="manual" role="status" aria-live="polite" hidden>
    <span data-coplan--editor-target="uploadMessage"></span>
    <button type="button" class="btn btn--secondary btn--sm" aria-label="<%= t("coplan.editor.dismiss_upload_errors") %>" data-coplan--editor-target="uploadDismiss" data-action="coplan--editor#dismissUploadErrors" hidden><%= t("coplan.editor.dismiss") %></button>
  </div>
  <div class="document-editor__paper plan-document card"<% if inline_editor %> data-action="mouseup->coplan--text-selection#handleEditorMouseUp"<% end %>>
    <div class="document-editor__raw" data-coplan--editor-target="rawSurface" hidden></div>
    <div class="document-editor__body" data-coplan--editor-target="surface"></div>
    <%= text_area_tag :content, @draft_content, hidden: true, aria: { label: t("coplan.editor.messages.document_markdown") }, data: { "coplan--editor-target": "textarea" } %>
    <%= hidden_field_tag :base_revision, @base_revision %>
  </div>
<% end %>
