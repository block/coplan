<% content_for(:title, "New #{@new_plan_type&.name || 'document'} — CoPlan") %>
<% content_for(:head) do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<% back_path = @new_folder ? folder_browse_path(@new_folder) : library_browse_path(current_user.library) %>

<div data-controller="coplan--inline-editor"
     data-action="coplan:editor-ready->coplan--inline-editor#ready coplan:editor-closed->coplan--inline-editor#closed coplan:editor-saved->coplan--inline-editor#draftSaved"
     data-coplan--inline-editor-draft-value="true"
     data-coplan--inline-editor-auto-open-value="true"
     data-coplan--inline-editor-focus-title-value="true">
  <div class="plan-masthead" data-plan-section="top">
    <div class="page-header page-header--plan" id="plan-header">
      <%= plan_type_icon(@new_plan_type || CoPlan::PlanType.general, size: :lg) %>
      <div class="page-header__text">
        <h1 class="page-header__title"></h1>
        <div class="page-header__byline text-sm text-muted">
          <%= user_avatar(current_user) %> <%= profile_link(current_user) %> ·
          <span data-coplan--inline-editor-target="draftState">Shared on first save · Not saved</span>
          <span aria-hidden="true">·</span> <%= link_to @new_folder ? @new_folder.name : "My Plans", back_path, class: "plan-location-link" %>
        </div>
      </div>
    </div>
    <div class="plan-masthead__side">
      <div id="plan-toolbar" class="plan-actions" role="toolbar" aria-label="Plan actions">
        <%= link_to "Done", back_path, class: "btn btn--ghost btn--sm", data: { action: "click->coplan--inline-editor#finishDraft", "coplan--inline-editor-target": "trigger" } %>
      </div>
    </div>
  </div>

  <div class="plan-document card">
    <div class="plan-layout">
      <div class="plan-layout__content">
        <div data-coplan--inline-editor-target="reader" hidden></div>
        <div class="inline-editor" data-coplan--inline-editor-target="editor">
          <%= render "coplan/plans/editor_form", inline_editor: true %>
        </div>
      </div>
    </div>
  </div>
</div>
