<% displaced = threads.select { |thread| thread.out_of_date? && thread.anchor_kind.blank? } %>
<aside id="plan-detached-comments" class="detached-comments<%= ' detached-comments--all-resolved' if displaced.any? && displaced.all?(&:closed?) %>" aria-label="Comments on earlier text"<%= " hidden" if displaced.empty? %>>
  <% if displaced.any? %>
    <details class="document-support__disclosure" data-controller="coplan--support-disclosure" data-action="toggle->coplan--support-disclosure#remember" open><summary class="document-support__heading"><span class="document-support__chevron" aria-hidden="true">›</span><h2 class="plan-footnote__title">Earlier comments</h2><span class="document-support__count"><%= displaced.size %></span></summary>
    <div class="document-support__content">
    <% displaced.each do |thread| %>
      <%= render "coplan/plans/document_comment", thread: thread, review: nil, detached: true %>
    <% end %>
    </div></details>
  <% end %>
</aside>
