<%# Shared document footer: matching disclosure rows keep empty sections compact. %>
<div class="plan-footnotes">
  <section class="plan-footnote" id="footnote-references" data-plan-section="references" aria-labelledby="footnote-references-title">
    <% back_matter = plan_citation_back_matter(plan, references) %>
    <% listed_references = listed_plan_references(references, back_matter[:cited_urls]) %>
    <details class="document-support__disclosure" data-controller="coplan--support-disclosure" data-action="toggle->coplan--support-disclosure#remember" open>
      <summary class="document-support__heading"><span class="document-support__chevron" aria-hidden="true">›</span><h2 class="plan-footnote__title" id="footnote-references-title">References</h2>
      <%= plan_section_count(back_matter[:count] + listed_references.size, id: "references-count") %></summary>
      <div class="document-support__content">
    <%= render partial: "coplan/plans/citations", locals: { plan: plan, back_matter: back_matter } %>
    <%= render partial: "coplan/plans/references", locals: {
          references: listed_references,
          plan: plan,
          has_citations: back_matter[:count].positive?
        } %>
      </div>
    </details>
      <% if current_user && allowed_to?(plan, :contribute?) %>
        <button type="button" class="section-add document-support__add" data-action="coplan--plan-details#openSupport" popovertarget="add-reference-modal" title="Add a reference" aria-label="Add a reference">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        </button>
      <% end %>
  </section>

  <section class="plan-footnote" id="footnote-attachments" data-plan-section="attachments" aria-labelledby="footnote-attachments-title">
    <details class="document-support__disclosure" data-controller="coplan--support-disclosure" data-action="toggle->coplan--support-disclosure#remember" open>
      <summary class="document-support__heading"><span class="document-support__chevron" aria-hidden="true">›</span><h2 class="plan-footnote__title" id="footnote-attachments-title">Attachments</h2>
      <%= plan_section_count(attachments.size, id: "attachments-count") %></summary>
      <div class="document-support__content">
    <%= render partial: "coplan/plans/attachments", locals: { attachments: attachments, plan: plan } %>
      </div>
    </details>
      <% if current_user && allowed_to?(plan, :contribute?) %>
        <button type="button" class="section-add document-support__add" data-action="coplan--plan-details#openSupport" popovertarget="add-attachment-modal" title="Add files" aria-label="Add files">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        </button>
      <% end %>
  </section>
  <%= render "coplan/reviews/controls", plan: plan %>
</div>
