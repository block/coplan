<% content_for(:title, "History — #{@plan.title} — Coplan") %>

<% content_for :nav_title do %>
  <span class="site-nav__plan-context site-nav__plan-context--visible site-nav__plan-context--settling">
    <%= link_to plan_browse_path(@plan), class: "site-nav__doc-title" do %>
      <%= plan_type_icon(@plan, size: :sm) %>
      <span class="site-nav__doc-title-text"><%= @plan.title %></span>
    <% end %>
  </span>
<% end %>

<%# New versions/events broadcast into #plan-history-list while you watch. %>
<%= turbo_stream_from @plan %>

<div class="history-screen" data-controller="coplan--plan-keys"
     data-coplan--plan-keys-fallback-url-value="<%= plan_browse_path(@plan) %>">
  <div class="page-header history-heading">
    <%= link_to plan_browse_path(@plan), class: "history-back", title: "Back to the document (Backspace)", aria: { label: "Back to #{@plan.title}" } do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    <% end %>
    <h1 class="page-header__title">History</h1>
  </div>

  <div class="card history-page">
    <%= render partial: "coplan/plans/history", locals: { history_items: @history_items, plan: @plan } %>
  </div>
</div>
