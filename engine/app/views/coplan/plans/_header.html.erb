<%# The plan's identity: type icon + title, then the byline. Everything
    here derives from the plan alone — this partial is broadcast-replaced
    (content commits, visibility changes, API edits) with no current_user,
    so viewer-relative chrome (presence, the owner toolbar) lives in the
    masthead's side column next to this, never inside it. The location
    link is safe here: a plan lives in one place, the same for everyone. %>
<% placement = local_assigns.fetch(:placement) { plan.placement } %>
<div class="page-header page-header--plan" id="plan-header">
  <%= plan_type_icon(plan, size: :lg) %>
  <div class="page-header__text">
    <h1 class="page-header__title"><%= plan.title %></h1>
    <div class="page-header__byline text-sm text-muted">
      <%= user_avatar(plan.created_by_user) %> <%= profile_link(plan.created_by_user) %> · v<%= plan.current_revision %>
      <button type="button" class="plan-visibility-button" data-visibility="<%= plan.visibility %>" data-coplan--plan-details-target="visibilityButton" data-action="coplan--plan-details#openVisibility focus->coplan--plan-details#visibilityFocused blur->coplan--plan-details#visibilityBlurred" aria-haspopup="dialog" title="View or change plan visibility"><%= plan.draft? ? "Private" : "Shared" %><svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></button>
      <% if plan.archived? %><%= hidden_state_flag("Archived", "Hidden from lists unless filtered for") %><% end %>
      <%= render "coplan/plans/location_link", plan: plan, placement: placement, location: :masthead %>
    </div>
  </div>
</div>
