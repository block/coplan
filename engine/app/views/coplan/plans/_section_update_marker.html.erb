<%# Template for the quiet, inline section-update dots. %>
<template data-coplan--changed-sections-target="markerTemplate">
  <span class="section-update-marker" tabindex="0" role="note"
        data-action="mouseenter->coplan--changed-sections#hold mouseleave->coplan--changed-sections#release focusin->coplan--changed-sections#hold focusout->coplan--changed-sections#release"></span>
</template>
