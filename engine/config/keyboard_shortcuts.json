{
  "help": {
    "group": "everywhere",
    "global": true,
    "bindings": [
      {"id":"show","keys":["?"]}
    ]
  },
  "search": {
    "group": "everywhere",
    "bindings": [
      {"id":"open","keys":["/"]}
    ]
  },
  "library": {
    "group": "library",
    "bindings": [
      {"id":"next","keys":["j","ArrowDown"]},
      {"id":"previous","keys":["k","ArrowUp"]},
      {"id":"open","keys":["Enter"]},
      {"id":"up","keys":["Backspace"]},
      {"id":"home","keys":["Escape"]}
    ]
  },
  "plan": {
    "group": "plan",
    "bindings": [
      {"id":"back","keys":["Backspace"]},
      {"id":"previous","keys":["["]},
      {"id":"next","keys":["]"]}
    ]
  },
  "outline": {
    "group": "plan",
    "bindings": [
      {"id":"toggle","keys":["t"]}
    ]
  },
  "comments": {
    "group": "review_comments",
    "overlays": [".thread-popover"],
    "bindings": [
      {"id":"next","keys":["j","ArrowDown"]},
      {"id":"previous","keys":["k","ArrowUp"]},
      {"id":"reply","keys":["r"]},
      {"id":"resolve","keys":["e"]},
      {"id":"resolved","keys":["s"]}
    ]
  },
  "deck": {
    "group": "presentations",
    "bindings": [
      {"id":"start","keys":["p"]}
    ]
  },
  "presentation": {
    "group": "while_presenting",
    "bindings": [
      {"id":"next","keys":["ArrowRight","ArrowDown","PageDown"," "]},
      {"id":"previous","keys":["ArrowLeft","ArrowUp","PageUp","Backspace"]},
      {"id":"first","keys":["Home"]},
      {"id":"last","keys":["End"]},
      {"id":"draw","keys":["d"]},
      {"id":"fullscreen","keys":["f"]},
      {"id":"exit","keys":["Escape"]}
    ]
  },
  "results": {
    "group": "search_results",
    "local": true,
    "bindings": [
      {"id":"next","keys":["ArrowDown"]},
      {"id":"previous","keys":["ArrowUp"]},
      {"id":"open","keys":["Enter"]}
    ]
  },
  "reply": {
    "group": "writing_comments",
    "local": true,
    "bindings": [
      {"id":"submit","keys":["Enter"]},
      {"id":"newline","keys":["Shift+Enter"],"native":true},
      {"id":"link","keys":["Mod+k"]},
      {"id":"pasteLink","keys":["Mod+v"],"native":true}
    ]
  },
  "editor": {
    "group": "editing",
    "local": true,
    "bindings": [
      {"id":"save","keys":["Mod+s","Mod+Enter"]}
    ]
  },
  "table": {
    "group": "expanded_tables",
    "local": true,
    "bindings": [
      {"id":"up","keys":["ArrowUp"]},
      {"id":"down","keys":["ArrowDown"]},
      {"id":"left","keys":["ArrowLeft"]},
      {"id":"right","keys":["ArrowRight"]},
      {"id":"pageUp","keys":["PageUp"]},
      {"id":"pageDown","keys":["PageDown"]},
      {"id":"first","keys":["Home"]},
      {"id":"last","keys":["End"]},
      {"id":"start","keys":["Shift+Home"]},
      {"id":"end","keys":["Shift+End"]},
      {"id":"copy","keys":["Mod+c"]}
    ]
  },
  "native": {
    "group": "everywhere",
    "local": true,
    "bindings": [
      {"id":"dismiss","keys":["Escape"],"native":true}
    ]
  }
}
